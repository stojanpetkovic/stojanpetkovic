---
/**
 * TermsView — the body of the legal pages: Terms of use (`page="terms"`) and
 * the Privacy Policy (`page="privacy"`).
 *
 * Shared by the default-locale routes (`/terms`, `/privacy`) and the
 * locale-prefixed ones. All copy is read from `pages.<page>.*` in the locale
 * dictionaries; `{email}` in the copy becomes the site's contact address.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import { Hero } from '@/components/hero';
import siteConfig from '@/config/site.config';
import { t, tData, defaultLocale, localizedPath } from '@/i18n';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
  /** Which legal page to render. */
  page?: 'terms' | 'privacy';
}

interface Section {
  title: string;
  paragraphs: string[];
  items?: string[];
}

const { locale = defaultLocale, page = 'terms' } = Astro.props;

const withEmail = (text: string) => text.replaceAll('{email}', siteConfig.email);
const k = (key: string) => withEmail(t(`pages.${page}.${key}`, locale));
const hero = tData<{ badge: string; title: string; description: string }>(`pages.${page}.hero`, locale)!;
const sections = tData<Section[]>(`pages.${page}.sections`, locale)!.map((section) => ({
  title: section.title,
  paragraphs: section.paragraphs.map(withEmail),
  items: section.items?.map(withEmail),
}));
const contactUrl = localizedPath('/contact', locale);
---

<PageLayout
  title={k('meta.title')}
  description={k('meta.description')}
  eagerReveal
>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name={page === 'privacy' ? 'lock' : 'shield-check'} size="sm" />
      {hero.badge}
    </Badge>

    <h1 slot="title">{hero.title}</h1>

    <p slot="description" class="!text-balance">
      {hero.description}
    </p>
  </Hero>

  <section class="py-[var(--space-section-md)] border-t border-border">
    <article class="terms mx-auto max-w-3xl px-6" data-reveal>
      <p class="text-sm text-foreground-muted">{k('updated')}</p>
      <p class="mt-4 text-foreground-secondary leading-relaxed">{k('intro')}</p>

      {sections.map((section) => (
        <section class="mt-10">
          <h2 class="font-display text-xl font-bold text-foreground">{section.title}</h2>
          {section.paragraphs.map((p) => (
            <p class="mt-3 text-foreground-secondary leading-relaxed">{p}</p>
          ))}
          {section.items && (
            <ul class="mt-3 list-disc space-y-2 pl-5 text-foreground-secondary leading-relaxed">
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </section>
      ))}

      <p class="mt-10">
        <a class="font-medium text-brand-700 underline underline-offset-2" href={contactUrl}>
          {k('contactLink')}
        </a>
      </p>
    </article>
  </section>
</PageLayout>
