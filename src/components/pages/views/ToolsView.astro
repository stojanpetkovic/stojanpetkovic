---
/**
 * ToolsView — the Tools page body.
 *
 * Cards for the small cloud-based tools and calculators. Each card names the
 * area, the tool, what it does, what goes in and what comes out, and its
 * status. A tool that has no page of its own yet says so ("In preparation")
 * and the card leads to the contact page instead of a dead link. The last card
 * asks which tool is missing. Copy comes from `pages.tools.*`, so adding a tool
 * means adding one entry to `items` in each locale file.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { Image } from 'astro:assets';
import shot from '@/assets/tools/ct-simulator-well.webp';
import Button from '@/components/ui/form/Button/Button.astro';
import { t, tData, defaultLocale, localizedPath } from '@/i18n';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

interface Tool {
  /** Path of the tool's own page; a tool without one is still in preparation. */
  href?: string;
  tag: string;
  icon: string;
  title: string;
  description: string;
  inputs: string[];
  outputs: string[];
}

const { locale = defaultLocale } = Astro.props;

const hero = tData<{ badge: string; titleLead: string; titleHighlight: string; description: string }>('pages.tools.hero', locale)!;
const all = tData<Tool[]>('pages.tools.items', locale)!;
// The CT Simulator is software, not a calculator: it is shown first and larger, apart from the list.
const featured = all.find((tool) => tool.href === '/tools/ct-simulator')!;
const items = all.filter((tool) => tool !== featured);
const feat = tData<{ badge: string; title: string; text: string; hint: string; cta: string; listTitle: string }>('pages.tools.featured', locale)!;
const suggest = tData<{ title: string; text: string; cta: string }>('pages.tools.suggest', locale)!;

const contactUrl = localizedPath('/contact', locale);
---

<PageLayout
  title={t('pages.tools.meta.title', locale)}
  description={t('pages.tools.meta.description', locale)}
  footerBackground="secondary"
>
  <!-- Header -->
  <section class="web-head border-b border-border pb-12 pt-16 sm:pt-20">
    <div class="mx-auto max-w-5xl px-6">
      <p class="section-eyebrow !mb-0"><span>{hero.badge}</span></p>
      <h1 class="mt-4 max-w-3xl font-display text-3xl font-bold tracking-tight text-foreground sm:text-[2.5rem] sm:leading-[1.15]">
        {hero.titleLead} <span class="text-brand-700">{hero.titleHighlight}</span>
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-foreground-muted">{hero.description}</p>
    </div>
  </section>

  <!-- Tool list: one ruled row per tool -->
  <section class="bg-background py-10 sm:py-12">
    <div class="mx-auto max-w-5xl px-6">
      <!-- Featured: the CT Simulator, software -->
      <a href={localizedPath(featured.href!, locale)} class="group grid overflow-hidden rounded-2xl bg-brand-700 text-white shadow-lg transition-shadow hover:shadow-xl lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
        <div class="flex flex-col justify-center gap-4 p-6 sm:p-8">
          <span class="inline-flex w-fit items-center gap-2 rounded-full bg-white px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-widest text-brand-700">
            <Icon name={featured.icon} size="xs" />
            {feat.badge}
          </span>
          <h2 class="font-display text-3xl font-bold leading-tight !text-white">{featured.title}</h2>
          <p class="text-lg font-semibold leading-snug !text-white">{feat.title}</p>
          <p class="text-sm leading-relaxed text-white/85">{feat.text} {featured.description}</p>
          <span class="mt-2 inline-flex w-fit items-center gap-2 rounded-xl bg-white px-5 py-3 text-base font-bold text-brand-700 group-hover:bg-white/90">
            {feat.cta}
            <Icon name="arrow-right" size="sm" class="transition-transform group-hover:translate-x-0.5" />
          </span>
          <p class="text-xs text-white/75">{feat.hint}</p>
        </div>
        <div class="flex items-center bg-white/10 p-4 sm:p-5">
          <Image src={shot} alt="" widths={[480, 800]} sizes="(min-width: 1024px) 480px, 100vw" class="w-full rounded-lg shadow-md" loading="lazy" />
        </div>
      </a>

      <h2 class="mb-3 mt-10 font-mono text-[11px] font-semibold uppercase tracking-widest text-foreground-subtle">{feat.listTitle}</h2>
      <ul class="divide-y divide-border overflow-hidden rounded-xl border border-border bg-card shadow-sm" role="list">
        {items.map((tool) => {
          const href = tool.href ? localizedPath(tool.href, locale) : contactUrl;
          return (
            <li>
              <a href={href} class="group grid gap-4 p-5 transition-colors hover:bg-background-secondary sm:p-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)_auto] lg:items-center lg:gap-8">
                <div class="flex items-start gap-4">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-brand-700 text-white">
                    <Icon name={tool.icon} size="md" />
                  </span>
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      <h2 class="font-display text-lg font-bold leading-tight text-foreground">{tool.title}</h2>
                      <span class="font-mono text-[10px] font-semibold uppercase tracking-widest text-brand-700">{tool.tag}</span>
                    </div>
                    <p class="mt-1.5 text-sm leading-relaxed text-foreground-muted">{tool.description}</p>
                  </div>
                </div>

                <dl class="grid gap-2.5 text-sm">
                  <div class="grid grid-cols-[4.5rem_1fr] gap-3">
                    <dt class="pt-0.5 font-mono text-[10px] font-semibold uppercase tracking-widest text-foreground-subtle">{t('pages.tools.inputsLabel', locale)}</dt>
                    <dd class="leading-snug text-foreground-muted">{tool.inputs.join(' · ')}</dd>
                  </div>
                  <div class="grid grid-cols-[4.5rem_1fr] gap-3">
                    <dt class="pt-0.5 font-mono text-[10px] font-semibold uppercase tracking-widest text-foreground-subtle">{t('pages.tools.outputsLabel', locale)}</dt>
                    <dd class="leading-snug text-foreground-muted">{tool.outputs.join(' · ')}</dd>
                  </div>
                </dl>

                <div class="flex items-center justify-between gap-4 lg:flex-col lg:items-end lg:justify-center lg:gap-3">
                  <span class:list={['inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium', tool.href ? 'border-brand-200 bg-brand-50 text-brand-700' : 'border-border bg-background-secondary text-foreground-muted']}>
                    <span class:list={['h-1.5 w-1.5 rounded-full', tool.href ? 'bg-brand-600' : 'bg-foreground-subtle']} aria-hidden="true"></span>
                    {t(tool.href ? 'pages.tools.statusAvailable' : 'pages.tools.status', locale)}
                  </span>
                  <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 group-hover:underline underline-offset-4">
                    {t(tool.href ? 'pages.tools.open' : 'pages.tools.cta', locale)}
                    <Icon name="arrow-right" size="sm" class="transition-transform group-hover:translate-x-0.5" />
                  </span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>

      <!-- Suggest a tool -->
      <div class="mt-6 flex flex-col gap-4 rounded-xl border border-dashed border-border bg-background-secondary p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <div>
          <h2 class="font-display text-base font-bold text-foreground">{suggest.title}</h2>
          <p class="mt-1 text-sm leading-relaxed text-foreground-muted">{suggest.text}</p>
        </div>
        <Button variant="brand-outline" href={contactUrl} class="shrink-0 self-start sm:self-auto">
          {suggest.cta}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>

      <p class="mt-6 flex items-start gap-2 text-xs leading-relaxed text-foreground-subtle">
        <Icon name="info" size="xs" class="mt-0.5 shrink-0" />
        {t('pages.tools.note', locale)}
      </p>
    </div>
  </section>
</PageLayout>
