---
/**
 * WebView — the Web page body.
 *
 * Web work is a side service next to the engineering, so the page is short and
 * quiet: a header with a small fact panel, three one-line capabilities, the client websites as a
 * compact list, two client quotes and a single line to get in touch. No hero
 * halo, no numbered sections, no closing band. Copy comes from `pages.web.*`;
 * the projects heading and the quotes are read from `pages.home.portfolio` and
 * `pages.home.testimonials`, so each piece of text lives once.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Image } from 'astro:assets';
import { getVisibleProjects, getProjectUrl } from '@/lib/projects';
import { t, tData, defaultLocale, localizedPath } from '@/i18n';

interface Props {
  /** Locale whose copy and content this page renders. Defaults to the site default. */
  locale?: string;
}

interface IconCard {
  icon: string;
  title: string;
  description: string;
}
interface Testimonial {
  quote: string;
  name: string;
  role: string;
}

const { locale = defaultLocale } = Astro.props;

// The client websites, falling back to the default locale so the list is never
// empty on a locale that has not translated them.
let projectItems = await getVisibleProjects(locale, 'web');
if (projectItems.length === 0 && locale !== defaultLocale) {
  projectItems = await getVisibleProjects(defaultLocale, 'web');
}
const projects = projectItems.filter((p) => p.data.featured).slice(0, 4);

const hero = tData<{ badge: string; titleLead: string; titleHighlight: string; description: string; primaryCta: string; secondaryCta: string }>(
  'pages.web.hero',
  locale
)!;
const services = tData<{ heading: string; cards: IconCard[] }>('pages.web.services', locale)!;
const glance = tData<{ label: string; items: { label: string; value: string }[] }>('pages.web.glance', locale)!;
const portfolio = tData<{ heading: string }>('pages.home.portfolio', locale)!;
const testimonials = tData<{ heading: string; items: Testimonial[] }>('pages.home.testimonials', locale)!;

const servicesUrl = localizedPath('/services', locale);
const contactUrl = localizedPath('/contact', locale);
---

<PageLayout
  title={t('pages.web.meta.title', locale)}
  description={t('pages.web.meta.description', locale)}
  footerBackground="secondary"
>
  <!-- Header: copy on the left, a small fact panel on the right -->
  <section class="web-head border-b border-border pb-12 pt-16 sm:pt-20">
    <div class="mx-auto grid max-w-5xl items-start gap-10 px-6 lg:grid-cols-[1.35fr_1fr] lg:gap-14">
      <div>
        <p class="section-eyebrow !mb-0"><span>{hero.badge}</span></p>
        <h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-foreground sm:text-[2.5rem] sm:leading-[1.15]">
          {hero.titleLead} <span class="text-brand-700">{hero.titleHighlight}</span>
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-foreground-muted">{hero.description}</p>
        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button href={contactUrl}>
            {hero.primaryCta}
            <Icon name="arrow-right" size="sm" />
          </Button>
          <a href={servicesUrl} class="text-sm font-medium text-foreground-muted underline-offset-4 hover:text-foreground hover:underline">
            {hero.secondaryCta}
          </a>
        </div>
      </div>

      <aside class="overflow-hidden rounded-xl border border-border bg-card shadow-sm" aria-label={glance.label}>
        <p class="border-b border-border bg-background-secondary px-5 py-2.5 font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-foreground-secondary">{glance.label}</p>
        <dl class="divide-y divide-border">
          {glance.items.map((item) => (
            <div class="grid grid-cols-[6.5rem_1fr] gap-3 px-5 py-3">
              <dt class="font-mono text-[11px] font-semibold uppercase tracking-widest text-foreground-subtle">{item.label}</dt>
              <dd class="text-sm font-medium leading-snug text-foreground">{item.value}</dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  <!-- What it covers: three short lines -->
  <section class="bg-background py-12">
    <div class="mx-auto max-w-5xl px-6">
      <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-3" role="list">
        {services.cards.map((card) => (
          <li class="flex gap-3">
            <Icon name={card.icon} size="sm" class="mt-1 text-brand-700" />
            <div>
              <h2 class="text-sm font-semibold text-foreground">{card.title}</h2>
              <p class="mt-1 text-sm leading-relaxed text-foreground-muted">{card.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Client websites: a compact list -->
  <section id="work" class="border-t border-border bg-background-secondary py-12">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-foreground-muted">{portfolio.heading}</h2>
      <ul class="mt-4 divide-y divide-border rounded-xl border border-border bg-card" role="list">
        {projects.map((project) => (
          <li>
            <a
              href={getProjectUrl(project.id, project.data.locale)}
              class="group flex items-center gap-4 p-3 transition-colors hover:bg-background-secondary sm:gap-5 sm:p-4"
            >
              {project.data.image && (
                <Image
                  src={project.data.image}
                  alt=""
                  widths={[120, 240]}
                  sizes="96px"
                  class="hidden h-14 w-24 shrink-0 rounded-md border border-border object-cover sm:block"
                  loading="lazy"
                />
              )}
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-semibold text-foreground">{project.data.title}</span>
                <span class="mt-0.5 line-clamp-1 block text-xs text-foreground-muted">{project.data.description}</span>
              </span>
              {project.data.year && <span class="font-mono text-xs text-foreground-subtle">{project.data.year}</span>}
              <Icon name="arrow-up-right" size="sm" class="shrink-0 text-foreground-subtle transition group-hover:text-brand-700" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Two quotes, small -->
  <section class="border-t border-border bg-background py-12">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-foreground-muted">{testimonials.heading}</h2>
      <div class="mt-4 grid gap-6 md:grid-cols-2">
        {testimonials.items.map((item) => (
          <figure class="border-l-2 border-border pl-4">
            <blockquote class="text-sm leading-relaxed text-foreground-muted">{item.quote}</blockquote>
            <figcaption class="mt-2 text-xs text-foreground-subtle">
              <span class="font-medium text-foreground-muted">{item.name}</span>, {item.role}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- One quiet line -->
  <section class="border-t border-border bg-background-secondary py-10">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6">
      <p class="text-sm text-foreground-muted">{t('pages.web.closing', locale)}</p>
      <Button variant="brand-outline" href={contactUrl}>
        {hero.primaryCta}
        <Icon name="arrow-right" size="sm" />
      </Button>
    </div>
  </section>
</PageLayout>
