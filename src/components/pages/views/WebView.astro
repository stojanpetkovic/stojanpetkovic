---
/**
 * WebView — the Web development page body.
 *
 * The part of the site for web work, kept apart from the engineering story on
 * the home page: what is built, the client projects, what clients say, and a
 * way to get in touch. Shared by the default-locale route (`/web`) and the
 * locale-prefixed route (`/<locale>/web`).
 *
 * Copy comes from `pages.web.*`. The projects heading and the testimonials are
 * read from `pages.home.portfolio` and `pages.home.testimonials`, and the
 * closing band from `pages.services.cta`, so each piece of text lives once.
 * Projects load for the active locale and fall back to the default locale so
 * the section is never empty on a locale that has not translated them.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import WebSections from '@/components/pages/views/WebSections.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { getVisibleProjects } from '@/lib/projects';
import { t, tData, defaultLocale, localizedPath } from '@/i18n';

interface Props {
  /** Locale whose copy and content this page renders. Defaults to the site default. */
  locale?: string;
}

interface IconCard {
  icon: string;
  title: string;
  description: string;
}
interface FaqItem {
  question: string;
  answer: string;
}
interface FaqCard {
  icon: string;
  title: string;
  items: FaqItem[];
}
interface Testimonial {
  quote: string;
  name: string;
  role: string;
}

const { locale = defaultLocale } = Astro.props;

let projectItems = await getVisibleProjects(locale);
if (projectItems.length === 0 && locale !== defaultLocale) {
  projectItems = await getVisibleProjects(defaultLocale);
}
const featuredProjects = projectItems
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const hero = tData<{
  badge: string;
  titleLead: string;
  titleHighlight: string;
  description: string;
  primaryCta: string;
  secondaryCta: string;
}>('pages.web.hero', locale)!;
const portfolio = tData<{ badge: string; heading: string; lead: string; viewAll: string }>(
  'pages.home.portfolio',
  locale
)!;
const testimonials = tData<{ badge: string; heading: string; lead: string; items: Testimonial[] }>(
  'pages.home.testimonials',
  locale
)!;
const faq = tData<{ badge: string; heading: string; lead: string; cards: FaqCard[] }>('pages.services.faq', locale)!;
const cta = tData<{ badge: string; heading: string; description: string; primary: string; secondary: string }>(
  'pages.services.cta',
  locale
)!;

const servicesUrl = localizedPath('/services', locale);
const projectsUrl = localizedPath('/projects', locale);
const aboutUrl = localizedPath('/about', locale);
const contactUrl = localizedPath('/contact', locale);
---

<PageLayout
  title={t('pages.web.meta.title', locale)}
  description={t('pages.web.meta.description', locale)}
  footerBackground="secondary"
>
  <Hero layout="centered" size="sm" class="isolate pb-[var(--space-section-md)]" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="code" size="sm" />
      {hero.badge}
    </Badge>
    <h1 slot="title">
      <span class="text-foreground">{hero.titleLead}</span><br />
      <span class="text-brand-500">{hero.titleHighlight}</span>
    </h1>

    <p slot="description" class="!text-balance">
      {hero.description}
    </p>

    <Fragment slot="actions">
      <Button size="lg" href={contactUrl}>
        {hero.primaryCta}
        <Icon name="arrow-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href={servicesUrl}>
        {hero.secondaryCta}
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>
  </Hero>

  <WebSections {locale} />

  <!-- Projects -->
  <section id="work" class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="section-head" data-reveal>
        <div>
          <p class="section-eyebrow"><span class="section-eyebrow-num">06</span><span>{portfolio.badge}</span></p>
          <h2 class="font-display text-3xl md:text-4xl lg:text-[2.75rem] lg:leading-[1.12] font-bold tracking-tight text-foreground">{portfolio.heading}</h2>
        </div>
        <p class="section-lead">{portfolio.lead}</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {featuredProjects.map((project, i) => (
          <ProjectCard project={project} index={i} locale={project.data.locale} />
        ))}
      </div>

      <div class="text-center mt-4">
        <Button variant="brand-outline" href={projectsUrl}>
          {portfolio.viewAll}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="section-head" data-reveal>
        <div>
          <p class="section-eyebrow"><span class="section-eyebrow-num">07</span><span>{testimonials.badge}</span></p>
          <h2 class="font-display text-3xl md:text-4xl lg:text-[2.75rem] lg:leading-[1.12] font-bold tracking-tight text-foreground">{testimonials.heading}</h2>
        </div>
        <p class="section-lead">{testimonials.lead}</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {testimonials.items.map((item, i) => (
          <Card variant="elevated" padding="lg" hover data-reveal data-reveal-delay={i || undefined}>
            <div class="flex flex-col h-full gap-4">
              <div class="flex gap-1 text-brand-500" role="img" aria-label="5 out of 5 stars">
                {[...Array(5)].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <blockquote class="flex-1 text-foreground-muted leading-relaxed">
                {item.quote}
              </blockquote>
              <div class="flex items-center gap-3 pt-4 border-t border-border">
                <div class="w-9 h-9 rounded-full bg-gradient-to-br from-brand-500/30 to-brand-500/10 flex items-center justify-center text-brand-500 font-bold text-sm shrink-0">
                  {item.name.charAt(0)}
                </div>
                <div>
                  <p class="text-sm font-semibold text-foreground">{item.name}</p>
                  <p class="text-xs text-foreground-muted">{item.role}</p>
                </div>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Questions & answers -->
  <section id="faq" class="py-[var(--space-section-md)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="section-head" data-reveal>
        <div>
          <p class="section-eyebrow"><span class="section-eyebrow-num">08</span><span>{faq.badge}</span></p>
          <h2 class="font-display text-3xl md:text-4xl lg:text-[2.75rem] lg:leading-[1.12] font-bold tracking-tight text-foreground">{faq.heading}</h2>
        </div>
        <p class="section-lead">{faq.lead}</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {faq.cards.map((card, cardIndex) => (
          <Card variant="elevated" padding="lg" data-reveal data-reveal-delay={cardIndex + 1}>
            <div class="flex items-center gap-3 pb-4 border-b border-border">
              <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
                <Icon name={card.icon} size="md" />
              </div>
              <h3 class="font-display text-base font-semibold text-foreground">{card.title}</h3>
            </div>
            <div class="w-full">
              {card.items.map((item) => (
                <details class="border-b border-border last:border-0" name={`web-faq-${cardIndex}`}>
                  <summary class="flex w-full items-center justify-between text-sm py-4 text-left font-medium text-foreground transition-colors hover:text-foreground-secondary cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    {item.question}
                    <Icon name="chevron-down" size="sm" class="faq-icon shrink-0 text-foreground-muted transition-transform duration-200" />
                  </summary>
                  <div class="pb-4 text-sm text-foreground-muted leading-relaxed" set:html={item.answer} />
                </details>
              ))}
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <LetterGlitchBand desktopOnly={false}>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {cta.heading}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {cta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href={contactUrl}>
          {cta.primary}
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" class="cta-btn-brand" href={aboutUrl}>
          {cta.secondary}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </LetterGlitchBand>
  </section>
</PageLayout>

<style is:global>
  /* FAQ accordion: rotate the chevron while an item is open. */
  details[open] > summary .faq-icon {
    transform: rotate(180deg);
  }
</style>
