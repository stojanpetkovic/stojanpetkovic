---
/**
 * N2ZTable — the compressibility factor of nitrogen as a diagram and a table.
 *
 * The diagram plots Z against absolute pressure for a few temperatures and marks
 * the conditions of the current calculation (the script listens for the
 * `tool-result` event of `initToolForm`). The table lists every value of
 * `src/lib/tools/n2-z.ts`. Pressures are in bar and temperatures in °C, with the
 * oilfield units beside them. Copy comes from `pages.tools.nitrogenZ.*`.
 */
import { t } from '@/i18n';
import { Z_PRESSURES, Z_TABLE, Z_TEMPERATURES } from '@/lib/tools/n2-z';

interface Props {
  locale: string;
}
const { locale } = Astro.props;

const W = 640;
const H = 340;
const margin = { left: 52, right: 74, top: 16, bottom: 46 };
const xMax = 500;
const yMin = 0.95;
const yMax = 1.4;
const x = (bar: number) => margin.left + (bar / xMax) * (W - margin.left - margin.right);
const y = (z: number) => margin.top + (1 - (z - yMin) / (yMax - yMin)) * (H - margin.top - margin.bottom);

// One curve per column shown, from cold to hot.
const shown = [0, 2, 4, 6, 9];
const shades = ['--color-brand-300', '--color-brand-400', '--color-brand-500', '--color-brand-700', '--color-brand-900'];
const curves = shown.map((column, i) => ({
  temperature: Z_TEMPERATURES[column],
  shade: shades[i],
  points: Z_PRESSURES.map((p, row) => `${x(p).toFixed(1)},${y(Z_TABLE[row][column]).toFixed(1)}`).join(' '),
  endY: y(Z_TABLE[Z_PRESSURES.length - 1][column]),
}));
const yTicks = [1, 1.05, 1.1, 1.15, 1.2, 1.25, 1.3, 1.35, 1.4].filter((v) => v >= yMin).concat([0.95]);
const xTicks = [0, 100, 200, 300, 400, 500];

const toPsi = (bar: number) => Math.round(bar * 14.5038);
const toF = (c: number) => Math.round(c * 1.8 + 32);
const cell = new Intl.NumberFormat(locale, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
const intFormat = new Intl.NumberFormat(locale);
const label = (key: string) => t(`pages.tools.nitrogenZ.${key}`, locale);
---

<section class="mt-14 border-t border-border pt-10" aria-labelledby="n2z-title">
  <h2 id="n2z-title" class="font-display text-2xl font-bold text-foreground">{label('title')}</h2>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-foreground-muted">{label('intro')}</p>

  <figure class="mt-6 max-w-3xl">
    <svg
      id="n2z-chart"
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label={label('chartLabel')}
      class="h-auto w-full"
      data-x0={margin.left}
      data-x1={W - margin.right}
      data-y0={margin.top}
      data-y1={H - margin.bottom}
      data-xmax={xMax}
      data-ymin={yMin}
      data-ymax={yMax}
    >
      {
        yTicks.map((v) => (
          <g>
            <line x1={margin.left} x2={W - margin.right} y1={y(v)} y2={y(v)} style="stroke: var(--color-border)" />
            <text x={margin.left - 8} y={y(v) + 4} text-anchor="end" font-size="11" style="fill: var(--color-foreground-muted)">
              {v.toFixed(2)}
            </text>
          </g>
        ))
      }
      {
        xTicks.map((v) => (
          <g>
            <line x1={x(v)} x2={x(v)} y1={margin.top} y2={H - margin.bottom} style="stroke: var(--color-border)" />
            <text x={x(v)} y={H - margin.bottom + 16} text-anchor="middle" font-size="11" style="fill: var(--color-foreground-muted)">
              {v}
            </text>
          </g>
        ))
      }
      <line x1={x(0)} x2={x(xMax)} y1={y(1)} y2={y(1)} stroke-dasharray="4 3" style="stroke: var(--color-foreground-subtle)" />
      {
        curves.map((c) => (
          <g>
            <polyline points={c.points} fill="none" stroke-width="2" stroke-linejoin="round" style={`stroke: var(${c.shade})`} />
            <text x={x(xMax) + 6} y={c.endY + 4} font-size="11" font-weight="600" style={`fill: var(${c.shade})`}>
              {c.temperature} °C
            </text>
          </g>
        ))
      }
      <text x={(margin.left + W - margin.right) / 2} y={H - 8} text-anchor="middle" font-size="12" style="fill: var(--color-foreground-muted)">
        {label('pressureAxis')}
      </text>
      <text x="14" y={margin.top + 4} font-size="12" style="fill: var(--color-foreground-muted)">Z</text>
      <g id="n2z-marker" display="none">
        <circle r="6" style="fill: var(--cta); stroke: var(--color-foreground)" stroke-width="1.5" />
      </g>
    </svg>
    <figcaption id="n2z-marker-note" class="mt-2 text-xs text-foreground-subtle" hidden>{label('marker')}</figcaption>
  </figure>

  <div class="mt-8 max-w-full overflow-x-auto rounded-lg border border-border">
    <table class="w-full min-w-[40rem] border-collapse text-sm">
      <caption class="sr-only">{label('title')}</caption>
      <thead>
        <tr class="bg-background-secondary text-left">
          <th scope="col" class="px-3 py-2 font-mono text-[11px] font-semibold uppercase tracking-widest text-foreground-subtle">
            {label('pressureHeader')}
          </th>
          {
            Z_TEMPERATURES.map((c) => (
              <th scope="col" class="px-3 py-2 text-right font-mono text-xs font-semibold text-foreground">
                {c} °C
                <span class="block text-[10px] font-normal text-foreground-subtle">{toF(c)} °F</span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        {
          Z_PRESSURES.map((p, row) => (
            <tr>
              <th scope="row" class="whitespace-nowrap px-3 py-1.5 text-left font-mono text-xs font-semibold text-foreground">
                {p} bar
                <span class="font-normal text-foreground-subtle"> · {intFormat.format(toPsi(p))} psi</span>
              </th>
              {Z_TABLE[row].map((z) => (
                <td class="px-3 py-1.5 text-right font-mono text-xs text-foreground-muted">{cell.format(z)}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="mt-3 max-w-3xl text-xs leading-relaxed text-foreground-subtle">{label('source')}</p>
</section>

<script>
  import { nitrogenZ } from '@/lib/tools/n2-z';

  function init() {
    const svg = document.getElementById('n2z-chart');
    const marker = document.getElementById('n2z-marker');
    const note = document.getElementById('n2z-marker-note');
    if (!svg || !marker || svg.dataset.init) return;
    svg.dataset.init = 'true';
    const d = (key: string) => Number(svg.dataset[key]);

    document.addEventListener('tool-result', (event) => {
      const { zPressure, zTemperature } = (event as CustomEvent).detail as Record<string, number>;
      if (typeof zPressure !== 'number' || typeof zTemperature !== 'number') return;
      const { z, inRange } = nitrogenZ(zPressure, zTemperature);
      const px = d('x0') + (Math.min(zPressure, d('xmax')) / d('xmax')) * (d('x1') - d('x0'));
      const clamped = Math.min(Math.max(z, d('ymin')), d('ymax'));
      const py = d('y0') + (1 - (clamped - d('ymin')) / (d('ymax') - d('ymin'))) * (d('y1') - d('y0'));
      marker.setAttribute('transform', `translate(${px.toFixed(1)} ${py.toFixed(1)})`);
      marker.setAttribute('display', inRange ? 'inline' : 'none');
      if (note) note.hidden = !inRange;
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
