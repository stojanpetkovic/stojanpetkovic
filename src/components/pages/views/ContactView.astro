---
/**
 * ContactView — the Contact page body.
 *
 * Shared by the default-locale route (`/contact`) and the locale-prefixed route
 * (`/<locale>/contact`). An engineering enquiry: what I can help with, what
 * happens after the message, three headline facts, and the three-step form. The
 * copy is read from `pages.contact.*`; the form is the same component as the
 * landing page's, pointed at its own `pages.contact.form` copy, and the
 * privacy notice is shared with the landing page.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import { Hero } from '@/components/hero';
import WebsiteCheckForm from '@/components/patterns/WebsiteCheckForm.astro';
import siteConfig from '@/config/site.config';
import { t, tData, defaultLocale } from '@/i18n';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const hero = tData<{ badge: string; titleLead: string; titleHighlight: string; description: string }>(
  'pages.contact.hero',
  locale
)!;
const help = tData<{ icon: string; title: string; text: string }[]>('pages.contact.help', locale)!;
const next = tData<string[]>('pages.contact.next', locale)!;
const facts = tData<{ value: string; label: string }[]>('pages.contact.facts', locale)!;
---

<PageLayout
  title={t('pages.contact.meta.title', locale)}
  description={t('pages.contact.meta.description', locale)}
  eagerReveal
>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="mail" size="sm" />
      {hero.badge}
    </Badge>

    <h1 slot="title">
      {hero.titleLead} <span class="text-brand-500">{hero.titleHighlight}</span>
    </h1>

    <p slot="description" class="!text-balance">
      {hero.description}
    </p>
  </Hero>

  <section class="relative isolate overflow-hidden py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="relative z-10 mx-auto max-w-5xl px-6">
      <div class="grid grid-cols-1 glitch:grid-cols-5 gap-10 glitch:gap-14 items-start">

        <!-- Left column: what I can help with, what happens next, the facts -->
        <div class="glitch:col-span-2 space-y-8 sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0 order-2 glitch:order-1" data-reveal data-reveal-ease="smooth">
          <div>
            <p class="section-eyebrow"><span>{t('pages.contact.helpTitle', locale)}</span></p>
            <ul class="mt-4 space-y-4" role="list">
              {help.map((item) => (
                <li class="flex gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-700 text-white">
                    <Icon name={item.icon} size="sm" />
                  </span>
                  <div>
                    <p class="font-display font-bold text-foreground">{item.title}</p>
                    <p class="mt-0.5 text-sm text-foreground-muted">{item.text}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <p class="section-eyebrow"><span>{t('pages.contact.nextTitle', locale)}</span></p>
            <ol class="mt-4 space-y-3" role="list">
              {next.map((item, i) => (
                <li class="flex gap-3 text-sm text-foreground">
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded bg-brand-100 font-mono text-[11px] font-semibold text-brand-700">{i + 1}</span>
                  <span>{item}</span>
                </li>
              ))}
            </ol>
          </div>

          <dl class="grid grid-cols-3 gap-3 border-t border-border pt-6">
            {facts.map((item) => (
              <div>
                <dt class="whitespace-nowrap font-display text-xl font-extrabold text-brand-700">{item.value}</dt>
                <dd class="mt-0.5 text-xs text-foreground-muted">{item.label}</dd>
              </div>
            ))}
          </dl>

          <p class="text-sm text-foreground-muted">
            {t('pages.contact.preferEmail', locale)}
            <a href={`mailto:${siteConfig.email}`} class="font-medium text-foreground underline underline-offset-2 hover:text-brand-500">{siteConfig.email}</a>
          </p>
        </div>

        <!-- Right column: the form, first on phones -->
        <div class="glitch:col-span-3 sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0 order-1 glitch:order-2" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <WebsiteCheckForm {locale} source="contact" copy="pages.contact" />
        </div>

      </div>
    </div>
  </section>
</PageLayout>
