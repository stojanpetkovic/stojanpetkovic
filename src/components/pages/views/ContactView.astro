---
/**
 * ContactView — the Contact page body.
 *
 * Shared by the default-locale route (`/contact`) and the locale-prefixed route
 * (`/<locale>/contact`). Left: who answers and the direct lines (phone,
 * WhatsApp, email), then what happens after the message and three facts;
 * right: the one-step form. Below both, a
 * Google map of where I work from (LocationMap). The
 * copy is read from `pages.contact.*`; the form is the same component as the
 * landing page's, pointed at its own `pages.contact.form` copy, and the
 * privacy notice is shared with the landing page.
 */
import { createProfessionalServiceSchema } from '@/lib/schema';
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import { Hero } from '@/components/hero';
import LeadForm from '@/components/patterns/LeadForm.astro';
import LocationMap from '@/components/patterns/LocationMap.astro';
import siteConfig from '@/config/site.config';
import { Image } from 'astro:assets';
import portraitImg from '@/assets/profile/stojan-portrait-office.webp';
import { t, tData, defaultLocale } from '@/i18n';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const hero = tData<{ badge: string; titleLead: string; titleHighlight: string; description: string }>(
  'pages.contact.hero',
  locale
)!;
const help = tData<{ icon: string; title: string; text: string }[]>('pages.contact.help', locale)!;
const next = tData<string[]>('pages.contact.next', locale)!;
const facts = tData<{ value: string; label: string }[]>('pages.contact.facts', locale)!;
const direct = tData<{ role: string; status: string; phone: string; whatsapp: string; email: string }>('pages.contact.direct', locale)!;

// Direct lines, as plain tel:/wa.me/mailto: links so webtano's leads.js
// counts each click like every other contact link on the site.
const phoneDigits = (siteConfig.phone ?? '').replace(/[^\d]/g, '');
const phonePretty = siteConfig.phone?.replace(/^\+381(\d{2})(\d{3})(\d+)$/, '+381 $1 $2 $3') ?? '';
const channels = [
  ...(phoneDigits ? [{ icon: 'phone', label: direct.phone, value: phonePretty, href: `tel:+${phoneDigits}`, external: false }] : []),
  ...(phoneDigits ? [{ icon: 'whatsapp', label: direct.whatsapp, value: phonePretty, href: `https://wa.me/${phoneDigits}`, external: true }] : []),
  { icon: 'mail', label: direct.email, value: siteConfig.email, href: `mailto:${siteConfig.email}`, external: false },
];
---

<PageLayout
  title={t('pages.contact.meta.title', locale)}
  description={t('pages.contact.meta.description', locale)}
  pageType="ContactPage"
  extraSchemas={[createProfessionalServiceSchema(locale)]}
  eagerReveal
>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="mail" size="sm" />
      {hero.badge}
    </Badge>

    <h1 slot="title">
      {hero.titleLead} <span class="text-brand-500">{hero.titleHighlight}</span>
    </h1>

    <p slot="description" class="!text-balance">
      {hero.description}
    </p>
  </Hero>

  <section class="relative isolate overflow-hidden py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="relative z-10 mx-auto max-w-5xl px-6">
      <div class="grid grid-cols-1 glitch:grid-cols-5 gap-10 glitch:gap-14 items-start">

        <!-- Left column: who answers, how to reach me directly, what happens next -->
        <div class="glitch:col-span-2 space-y-6 sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0 order-2 glitch:order-1" data-reveal data-reveal-ease="smooth">
          <div class="rounded-2xl border border-border bg-background p-5 shadow-sm">
            <div class="flex items-center gap-4">
              <Image src={portraitImg} alt={siteConfig.name} widths={[96, 192]} sizes="64px" class="h-16 w-16 shrink-0 rounded-full object-cover ring-2 ring-brand-500/20" />
              <div>
                <p class="font-display text-lg font-bold text-foreground">{siteConfig.name}</p>
                <p class="text-sm text-foreground-muted">{direct.role}</p>
                <p class="mt-1 inline-flex items-center gap-1.5 text-xs font-medium text-success">
                  <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
                  {direct.status}
                </p>
              </div>
            </div>
            <ul class="mt-5 divide-y divide-border border-t border-border" role="list">
              {channels.map((c) => (
                <li>
                  <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="group flex items-center gap-3 py-3 text-sm">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-500/10 text-brand-600 dark:text-brand-400">
                      <Icon name={c.icon} size="sm" />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-xs text-foreground-subtle">{c.label}</span>
                      <span class="block truncate font-medium text-foreground group-hover:text-brand-600">{c.value}</span>
                    </span>
                    <Icon name="arrow-up-right" size="sm" class="text-foreground-subtle transition group-hover:text-brand-600" />
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl border border-border bg-background p-5 shadow-sm">
            <p class="text-sm font-semibold text-foreground">{t('pages.contact.nextTitle', locale)}</p>
            <ol class="mt-4 space-y-4" role="list">
              {next.map((item, i) => (
                <li class="relative flex gap-3 text-sm text-foreground-muted">
                  {i < next.length - 1 && <span class="absolute left-3 top-7 h-[calc(100%-0.5rem)] w-px bg-border" aria-hidden="true"></span>}
                  <span class="relative flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-600 text-[11px] font-semibold text-white">{i + 1}</span>
                  <span class="pt-0.5">{item}</span>
                </li>
              ))}
            </ol>
            <dl class="mt-5 grid grid-cols-3 divide-x divide-border rounded-xl border border-border bg-background-secondary text-center">
              {facts.map((item) => (
                <div class="px-2 py-3">
                  <dt class="whitespace-nowrap font-display text-base font-bold text-brand-700 dark:text-brand-400">{item.value}</dt>
                  <dd class="mt-0.5 text-[11px] leading-tight text-foreground-muted">{item.label}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>

        <!-- Right column: the form, first on phones -->
        <div class="glitch:col-span-3 sm:max-w-xl sm:mx-auto glitch:max-w-none glitch:mx-0 order-1 glitch:order-2" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <LeadForm {locale} source="contact" copy="pages.contact" />
        </div>

      </div>
    </div>
  </section>

  <LocationMap {locale} class="border-t border-border bg-background" />
</PageLayout>
