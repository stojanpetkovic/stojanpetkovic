---
/**
 * BhaBuilderPanel — the BHA Builder itself: palette, tool cards, drawing,
 * summary and the printable sheet, wired to one BHA by
 * `src/lib/tools/bha-ui.ts`. Used by the CT
 * Simulator, where it is part of the second step. Copy comes from
 * `pages.bhaBuilder.*`.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { t, tData, defaultLocale } from '@/i18n';
import { EXAMPLES, KINDS } from '@/lib/tools/bha';

interface Props {
  /** Locale whose copy this panel renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const p = (key: string) => `pages.bhaBuilder.${key}`;
const palette = tData<{ title: string; hint: string }>(p('palette'), locale)!;
const types = tData<Record<string, string>>(p('types'), locale)!;
const examples = tData<Record<string, string>>(p('examples'), locale)!;
const fields = tData<Record<string, string>>(p('fields'), locale)!;
const drawing = tData<{ title: string }>(p('drawing'), locale)!;
const units = tData<{ label: string }>(p('units'), locale)!;
const summary = tData<Record<string, string>>(p('summary'), locale)!;
const data = tData<Record<string, string>>(p('data'), locale)!;
const print = tData<Record<string, string>>(p('print'), locale)!;
const copy = {
  types,
  examples,
  editor: tData<Record<string, string>>(p('editor'), locale)!,
  summary,
  data,
  print,
};
---

    <div id="bha-builder" class="mx-auto max-w-6xl px-6">
      <script is:inline type="application/json" id="bha-copy" set:html={JSON.stringify(copy)} />

      <!-- Toolbar -->
      <div class="bha-noprint flex flex-wrap items-center gap-x-4 gap-y-3">
        <!-- Set by the CT Simulator's unit switch, which covers the whole project -->
        <div role="group" aria-label={units.label} class="tool-segment" hidden>
          <button type="button" data-unit="us" aria-pressed="true">in · ft</button>
          <button type="button" data-unit="metric" aria-pressed="false">mm · m</button>
        </div>
        <select id="bha-example" class="bha-select" aria-label={data.example}>
          <option value="">{data.example}</option>
          {Object.keys(EXAMPLES).map((key) => <option value={key}>{examples[key]}</option>)}
        </select>
        <label class="wb-link cursor-pointer">
          {data.import}
          <input type="file" id="bha-import" accept="application/json,.json" class="sr-only" />
        </label>
        <button type="button" id="bha-export" class="wb-link">{data.export}</button>
        <button type="button" id="bha-reset" class="wb-link">{data.reset}</button>
        <button type="button" id="bha-print" class="wb-link inline-flex items-center gap-1.5">
          <Icon name="download" size="xs" />
          {print.button}
        </button>
        <span class="text-xs text-foreground-subtle">{data.note}</span>
      </div>
      <p id="bha-error" class="wb-error mt-3" role="alert" hidden></p>

      <!-- Header of the sheet -->
      <div class="bha-noprint mt-5 grid gap-3 sm:grid-cols-3">
        {
          (['bhaNo', 'runNo', 'preparedBy'] as const).map((key) => (
            <label class="wb-field">
              {fields[key]}
              <input data-meta={key} type="text" autocomplete="off" />
            </label>
          ))
        }
      </div>
      <p id="bha-print-head" class="bha-print-only bha-print-head"></p>

      <div class="bha-main-grid mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_26rem]">
        <div class="bha-noprint min-w-0 space-y-5">
          <div class="tool-card !p-4">
            <h2 class="font-mono text-[11px] font-semibold uppercase tracking-widest text-foreground-subtle">{palette.title}</h2>
            <p class="mt-2 text-xs leading-snug text-foreground-subtle">{palette.hint}</p>
            <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
              {
                KINDS.map((kind) => (
                  <div class="wb-tile" role="button" tabindex="0" data-add={kind}>{types[kind]}</div>
                ))
              }
            </div>
          </div>
          <div id="bha-list" class="space-y-3" aria-live="polite"></div>
        </div>

        <div class="min-w-0 lg:sticky lg:top-24 lg:self-start">
          <div class="tool-card min-w-0 !p-4">
            <h2 class="bha-noprint font-mono text-[11px] font-semibold uppercase tracking-widest text-foreground-subtle">{drawing.title}</h2>
            <div id="bha-svg" class="mt-2"></div>
            <dl id="bha-summary" class="wb-summary mt-3"></dl>
          </div>
        </div>
      </div>

      <section class="bha-print-only bha-print-table">
        <div id="bha-print-table"></div>
      </section>
      <p id="bha-print-foot" class="bha-print-only bha-print-foot" data-note={`${t('pages.tools.note', locale)} ${data.disclaimer}`}></p>

      <p class="bha-noprint mt-10 flex max-w-3xl items-start gap-2 text-xs leading-relaxed text-foreground-subtle">
        <Icon name="info" size="xs" class="mt-0.5 shrink-0" />
        {t('pages.tools.note', locale)} {data.disclaimer}
      </p>
    </div>

<script>
  import { BhaBuilder, type BhaCopy } from '@/lib/tools/bha-ui';

  function init() {
    const root = document.getElementById('bha-builder');
    const copy = document.getElementById('bha-copy');
    if (!root || !copy || root.dataset.init) return;
    root.dataset.init = 'true';
    new BhaBuilder(root, JSON.parse(copy.textContent ?? '{}') as BhaCopy);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
