---
/**
 * CtPressureLossView — the CT Pressure Loss calculator page.
 *
 * Inputs on the left, the result on the right, inside the shared `ToolPage`
 * shell. The calculation runs in the browser with `src/lib/tools/ct-pressure-loss.ts`
 * through `initToolForm`, which also handles the unit switch. Copy comes from
 * `pages.ctPressureLoss.*`; the script reads the regime labels from a data
 * attribute so no text is hard-coded in it.
 */
import ToolPage from './ToolPage.astro';
import ToolFields from './ToolFields.astro';
import ToolMethod from './ToolMethod.astro';
import { t, tData, defaultLocale } from '@/i18n';
import type { Quantity } from '@/lib/tools/units';

interface Props {
  /** Locale whose copy this page renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const p = (key: string) => `pages.ctPressureLoss.${key}`;
const hero = tData<{ badge: string; title: string; description: string }>(p('hero'), locale)!;
const groups = tData<Record<'fluid' | 'geometry' | 'flow', string>>(p('groups'), locale)!;
const fields = tData<Record<string, { label: string; hint?: string }>>(p('fields'), locale)!;
const results = tData<Record<string, string>>(p('results'), locale)!;
const regimes = tData<Record<string, string>>(p('regimes'), locale)!;
const method = tData<Parameters<typeof ToolMethod>[0]['method']>(p('method'), locale)!;

/** Worked example in oilfield units: the reference case the calculation is checked against. */
const example: Record<string, number> = {
  density: 15.52,
  n: 0.78,
  k: 0.836,
  reelDiameter: 83,
  od: 1.5,
  wall: 0.095,
  roughness: 0,
  totalLength: 10220,
  lengthOffReel: 2690,
  flowRate: 31,
};
/**
 * Starting values: fresh water (8.33 lb/gal, Newtonian so n = 1, K = 1 cP = 0.00209 lbf·s/100 ft²) in the
 * example string, so the page opens with a result before anything is typed.
 */
const defaults: Record<string, number> = { ...example, density: 8.33, n: 1, k: 0.00209 };

const layout: { id: keyof typeof groups; rows: { key: string; quantity: Quantity }[] }[] = [
  {
    id: 'fluid',
    rows: [
      { key: 'density', quantity: 'density' },
      { key: 'n', quantity: 'n' },
      { key: 'k', quantity: 'k' },
    ],
  },
  {
    id: 'geometry',
    rows: [
      { key: 'reelDiameter', quantity: 'diameter' },
      { key: 'od', quantity: 'diameter' },
      { key: 'wall', quantity: 'diameter' },
      { key: 'roughness', quantity: 'diameter' },
      { key: 'totalLength', quantity: 'length' },
      { key: 'lengthOffReel', quantity: 'length' },
    ],
  },
  { id: 'flow', rows: [{ key: 'flowRate', quantity: 'flowRate' }] },
];
---

<ToolPage
  locale={locale}
  title={t(p('meta.title'), locale)}
  description={t(p('meta.description'), locale)}
  hero={hero}
  resultTitle={results.title}
  example={example}
  defaults={defaults}
  data={{ regimes: JSON.stringify(regimes) }}
>
  <ToolFields
    groups={layout.map((g) => ({ id: g.id, label: groups[g.id], rows: g.rows }))}
    fields={fields}
    values={defaults}
  />

  <Fragment slot="results">
    <p class="mt-4 text-sm text-foreground-muted">{results.total}</p>
    <p class="mt-1 font-display text-4xl font-bold tracking-tight text-brand-700">
      <span data-out="total" data-quantity="pressure">–</span>
      <span data-unit-out="pressure" class="text-xl font-semibold text-foreground-muted">psi</span>
    </p>

    <dl class="mt-5 divide-y divide-border border-t border-border text-sm">
      {
        (['straight', 'curved'] as const).map((s) => (
          <div class="py-3">
            <div class="flex items-baseline justify-between gap-3">
              <dt class="font-medium text-foreground">{results[s]}</dt>
              <dd class="font-mono text-foreground">
                <span data-out={s} data-quantity="pressure">
                  –
                </span>{' '}
                <span data-unit-out="pressure" class="text-foreground-muted">
                  psi
                </span>
              </dd>
            </div>
            <p class="mt-0.5 text-xs text-foreground-subtle">
              {results.regime}: <span data-out={`${s}Regime`}>–</span>
            </p>
          </div>
        ))
      }
      <div class="flex items-baseline justify-between gap-3 py-3">
        <dt class="text-foreground-muted">{results.velocity}</dt>
        <dd class="font-mono text-foreground">
          <span data-out="velocity" data-quantity="velocity">–</span>
          <span data-unit-out="velocity" class="text-foreground-muted">ft/min</span>
        </dd>
      </div>
      <div class="flex items-baseline justify-between gap-3 py-3">
        <dt class="text-foreground-muted">{results.reynolds}</dt>
        <dd class="font-mono text-foreground"><span data-out="reynolds" data-decimals="0">–</span></dd>
      </div>
      <div class="flex items-baseline justify-between gap-3 py-3">
        <dt class="text-foreground-muted">{results.dean}</dt>
        <dd class="font-mono text-foreground"><span data-out="dean" data-decimals="0">–</span></dd>
      </div>
    </dl>
  </Fragment>

  <ToolMethod slot="method" method={method} />
</ToolPage>

<script>
  import { initToolForm } from '@/lib/tools/tool-form';
  import { calculateCtPressureLoss, validateCtInput, type CtInput } from '@/lib/tools/ct-pressure-loss';

  function init() {
    const root = document.getElementById('tool');
    if (!root) return;
    const regimes: Record<string, string> = JSON.parse(root.dataset.regimes ?? '{}');
    initToolForm(root, (input) => {
      const errors = validateCtInput(input as unknown as CtInput);
      if (errors.length > 0) return { errors };
      const r = calculateCtPressureLoss(input as unknown as CtInput);
      return {
        values: {
          total: r.total,
          straight: r.straight.pressureLoss,
          curved: r.curved.pressureLoss,
          straightRegime: regimes[r.straight.regime],
          curvedRegime: regimes[r.curved.regime],
          velocity: r.velocity,
          reynolds: r.reynolds,
          dean: r.dean,
        },
      };
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
