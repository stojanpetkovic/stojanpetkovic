---
/**
 * HomeView — the landing page body.
 *
 * Shared by the default-locale route (`/`) and the locale-prefixed route
 * (`/<locale>`). All copy is read from `pages.home.*` via `t()` / `tData()`,
 * and internal links are localized with `localizedPath`. Featured projects and
 * posts are loaded for the active locale and fall back to the default locale so
 * the sections are never empty on a locale that hasn't translated its content
 * yet. Each card links to the URL of the locale the content actually belongs
 * to, so a fallback (default-locale) item still points at a real page.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import siteConfig from '@/config/site.config';
import { getPostUrl, getPublishedPosts } from '@/lib/blog';
import { isEngineeringTag } from '@/lib/engineering';
import { t, tData, defaultLocale, localizedPath } from '@/i18n';

interface Props {
  /** Locale whose copy and content this page renders. Defaults to the site default. */
  locale?: string;
}

interface IconCard {
  icon: string;
  title: string;
  description: string;
}
interface Pillar extends IconCard {
  points: string[];
  /** The card's own page, when it has one. */
  href?: string;
}

const { locale = defaultLocale } = Astro.props;

/** The country a credential belongs to, named in the language of the page ("DE" becomes "Germany", "Nemačka"). */
const regionNames = new Intl.DisplayNames([locale], { type: 'region' });
const countryName = (code: string) => {
  try {
    return regionNames.of(code) ?? code;
  } catch {
    return code;
  }
};

let postItems = await getPublishedPosts(locale);
if (postItems.length === 0 && locale !== defaultLocale) {
  postItems = await getPublishedPosts(defaultLocale);
}
// The home page shows engineering posts only. Posts tagged for the web or for
// marketing stay on the blog and under /web; this section stays out of the way
// until there is an engineering post to show.
const posts = [...postItems]
  .filter((post) => post.data.tags.some(isEngineeringTag))
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf();
  })
  .slice(0, 4);

/** The redacted scans behind the two credential cards, in page order. */
const credentialScans: string[][] = [
  ['/credentials/ingenieur-1.webp?v=3', '/credentials/ingenieur-2.webp?v=3'],
  ['/credentials/exam-rs.webp?v=3', '/credentials/exam-de-1.webp', '/credentials/exam-de-2.webp'],
];

const hero = tData<{
  badge: string;
  titleLine1: string;
  titleLine2: string;
  titleLine3: string;
  description: string;
  /** Shorter variant shown below the `sm` breakpoint so the hero stays compact on phones. */
  descriptionMobile: string;
  primaryCta: string;
  secondaryCta: string;
  videoPlay: string;
  videoLabel: string;
  /** Credentials shown as badges under the hero buttons. */
  badges: { icon: string; tag: string; title: string; text: string; docTitle: string; docAlt: string; docDescription: string }[];
  credentialsDialog: { close: string; note: string; hint: string; zoom: string };
  qualifications: { label: string; items: { icon: string; year: string; title: string; text: string }[] };
}>('pages.home.hero', locale)!;
const workWithMe = tData<{ badge: string; heading: string; lead: string; cards: IconCard[]; cta: string }>(
  'pages.home.workWithMe',
  locale
)!;
const servicesSection = tData<{
  badge: string;
  heading: string;
  lead: string;
  learnMore: string;
  status: string;
  cards: Pillar[];
}>('pages.home.services', locale)!;
const webGateway = tData<{ badge: string; heading: string; lead: string; items: string[]; cta: string }>(
  'pages.home.webGateway',
  locale
)!;
const aboutTeaser = tData<{
  badge: string;
  headingLine1: string;
  headingLine2: string;
  para2: string;
  moreAboutMe: string;
  statsIntro: string;
  stat1: string;
  stat2: string;
  stat3: string;
  stat4: string;
  facts: { icon: string; label: string; value: string }[];
  basedIn: string;
}>('pages.home.aboutTeaser', locale)!;
const blogSection = tData<{ badge: string; heading: string; viewAll: string }>('pages.home.blog', locale)!;
const cta = tData<{ badge: string; heading: string; description: string; primary: string; secondary: string }>(
  'pages.home.cta',
  locale
)!;

/** Splits "13+ Years in Engineering" into its figure and its label. */
const splitStat = (stat: string) => {
  const cut = stat.indexOf(' ');
  return { value: stat.slice(0, cut), label: stat.slice(cut + 1) };
};

const servicesUrl = localizedPath('/services', locale);
const webUrl = localizedPath('/web', locale);
const aboutUrl = localizedPath('/about', locale);
const contactUrl = localizedPath('/contact', locale);
const blogUrl = localizedPath('/blog', locale);

// About-teaser copy with the configured location woven in (mirrors the original
// page's conditional). Falls back to a location-free sentence when no city is set.
const city = siteConfig.address?.city;
const country = siteConfig.address?.country;
const location = city ? (country ? `${city}, ${country}` : city) : '';
const aboutPara1 = location
  ? t('pages.home.aboutTeaser.para1WithLocation', locale, { location })
  : t('pages.home.aboutTeaser.para1NoLocation', locale);
const basedInDisplay = `${city ?? 'Your City'}${country ? `, ${country}` : ''}`;
---

<LandingLayout
  title={t('pages.home.meta.title', locale)}
  description={t('pages.home.meta.description', locale)}
  includePersonSchema={true}
  includeProfessionalServiceSchema={true}
  preloadImage="/video/hero-avatar-poster.webp?v=4"
>
  <!-- Hero -->
  <!-- data-header-flip-anchor: the header keeps its over-the-hero look until
       this section is nearly out from under it. See the flip threshold in
       Header.astro. The hero is a light wash, so it no longer sets the
       iOS toolbar colour and the body shows through (see bar-color.test.ts). -->
  {/* Below lg the photo stacks above the copy, and the xl hero's top padding
      (page-top + space-16, sized for a desktop headline) left far more room
      under the floating header than between the photo and the badge. The
      header pill ends 5rem from the top, so 5rem plus the grid's own gap
      puts the photo exactly one --space-section-gap below it, matching the
      gap under the photo. */}
  <Hero layout="split" imagePosition="left" size="xl" class="hero-dark-gradient max-lg:pt-[calc(5rem+var(--space-section-gap))]" fullHeight data-header-flip-anchor>
    {/* Framed like the header's own glass pill (bg-white/[0.08] + border
        white/[0.1]) so the treatment matches the rest of this hero rather
        than introducing a new material. */}
    {/* lg:h-[30rem] sets the frame a little taller than the text column
        (badge + heading + description + actions), not an exact match — and
        the image is object-contain, not object-cover, so the whole photo
        stays visible inside it (the frame's own width follows from lg:w-auto,
        hugging the image rather than stretching it to crop). */}
    {/* -mx-6 cancels the hero grid's own px-6 on phones/tablets, so the
        frame runs edge-to-edge instead of sitting inside the same gutter
        as the text — a noticeably bigger photo without touching the text
        column's own width. Reset at lg, where the frame goes back to
        hugging the image's own width beside the text (lg:justify-self-center). */}
    {/* Plain w-full on phones/tablets — no extra margin or max-width — so the
        frame matches the exact width of the grid's own content column, the
        same one the CTA buttons and the header/nav sit inside. Reset at lg,
        where it goes back to hugging the image's own width beside the text
        (lg:justify-self-center). */}
    {/* The avatar's own background is the brand blue, so a brand glow sits
        behind the frame: without it the bright square reads as pasted onto
        the dark hero rather than lit by it. */}
    {/* The intro video is a square crop with sound. Browsers only autoplay muted video,
        so it loops silently as a preview and the pill button restarts it from
        the start with sound and native controls. On lg the frame is a fixed
        30rem square so it sits beside the copy. */}
    <div slot="aside" class="hero-video relative w-full rounded-3xl border border-brand-400/30 bg-white/[0.08] p-2 shadow-2xl shadow-brand-500/30 backdrop-blur-md lg:w-full">
      <div class="pointer-events-none absolute -inset-12 -z-10 rounded-full bg-brand-500/35 blur-3xl" aria-hidden="true"></div>
      <video
        class="hero-video-el aspect-square w-full rounded-2xl bg-black object-cover"
        poster="/video/hero-avatar-poster.webp?v=4"
        width="720"
        height="720"
        muted
        loop
        playsinline
        preload="none"
        aria-label={hero.videoLabel}
      >
        <source src="/video/hero-avatar.webm?v=4" type="video/webm" />
        <source src="/video/hero-avatar.mp4?v=4" type="video/mp4" />
      </video>
      <button
        type="button"
        class="hero-video-play absolute bottom-5 left-5 inline-flex items-center gap-2 rounded-full bg-black/70 px-4 py-2 text-sm font-medium text-white backdrop-blur-md transition hover:bg-black/85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <Icon name="volume-2" size="sm" />
        {hero.videoPlay}
      </button>
    </div>

    <Badge slot="badge" variant="brand" pill pulse class="dark:text-brand-200">{hero.badge}</Badge>

    {/* 12.6vw fills the mobile column (~95-98% at 320-390px), sized to the
        English demo strings — translated hero copy is the site owner's to
        refit. The 3rem cap keeps the size continuous with sm:text-5xl at
        the 640px boundary. */}
    <h1 slot="title" class="!text-[clamp(1.75rem,10.4vw,3rem)] sm:!text-5xl md:!text-6xl lg:!text-7xl">
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor] whitespace-nowrap">{hero.titleLine1}</span><br />
      <span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">{hero.titleLine2}</span><br class="md:hidden" /><span class="text-brand-600 dark:text-foreground [-webkit-text-fill-color:currentColor]">{' '}{hero.titleLine3}</span>
    </h1>

    <p slot="description" class="!text-balance">
      <span class="sm:hidden">{hero.descriptionMobile}</span>
      <span class="hidden sm:inline">{hero.description}</span>
    </p>

   <Fragment slot="actions">
      <Button size="lg" href={contactUrl}>
        {hero.primaryCta}
        <Icon name="arrow-right" size="sm" />
      </Button>
      <Button size="lg" variant="outline" href="#focus">
        {hero.secondaryCta}
        <Icon name="arrow-right" size="sm" />
      </Button>
    </Fragment>

    {/* Credentials: the German title and the Serbian professional exam. */}
    <ul class="mt-8 grid w-full gap-3 sm:grid-cols-2" role="list">
      {hero.badges.map((badge, index) => (
        <li class="h-full">
          <button
            type="button"
            class="credential-card group flex h-full w-full items-center gap-4 rounded-xl border border-l-4 border-border border-l-brand-600 bg-card py-3.5 pl-4 pr-4 text-left shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:border-l-brand-600 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
            data-credential
            data-title={badge.docTitle}
            data-alt={badge.docAlt}
            data-description={badge.docDescription}
            data-images={JSON.stringify(credentialScans[index])}
            aria-haspopup="dialog"
            aria-label={`${badge.title}. ${hero.credentialsDialog.hint}`}
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-brand-700 text-white">
              <Icon name={badge.icon} size="md" />
            </span>
            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
              <span class="flex items-center gap-2">
                <span class="credential-flag" data-flag={badge.tag} aria-hidden="true"></span>
                <span class="font-mono text-[10px] font-semibold uppercase tracking-widest text-foreground-subtle">{countryName(badge.tag)}</span>
              </span>
              <span class="font-display text-[15px] font-bold leading-snug text-foreground">{badge.title}</span>
              <span class="text-xs leading-snug text-foreground-muted">{badge.text}</span>
            </span>
            <span class="credential-cue relative flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-brand-600" aria-hidden="true">
              <Icon name="file-search" size="sm" />
            </span>
          </button>
        </li>
      ))}
    </ul>

    {/* Qualifications and training, as a band along the foot of the hero. */}
    <div slot="bottom" class="mx-auto w-full max-w-7xl px-6">
      <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-md">
        <div class="flex items-center gap-3 border-b border-border bg-background-secondary px-5 py-2.5">
          <Icon name="award" size="sm" class="text-brand-700" />
          <p class="font-mono text-[11px] font-semibold uppercase tracking-widest text-foreground-secondary">{hero.qualifications.label}</p>
        </div>
        <ul class="grid grid-cols-1 divide-y divide-border sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x" role="list">
          {hero.qualifications.items.map((item) => (
            <li class="flex items-start gap-3 p-4 sm:[&:nth-child(n+3)]:border-t sm:[&:nth-child(n+3)]:border-border lg:[&:nth-child(n+3)]:border-t-0">
              <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-700">
                <Icon name={item.icon} size="sm" />
              </span>
              <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="flex items-baseline justify-between gap-2">
                  <span class="font-display text-sm font-bold leading-snug text-foreground">{item.title}</span>
                  <span class="shrink-0 font-mono text-[11px] font-semibold text-brand-700">{item.year}</span>
                </span>
                <span class="text-xs leading-snug text-foreground-muted">{item.text}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Hero>

  {/* The document viewer behind the credential cards. Filled in by the script
      below; the scans in /public/credentials have their personal details burned
      out of the image itself. */}
  <dialog id="credential-dialog" class="credential-dialog" aria-labelledby="credential-dialog-title">
    <div class="credential-dialog-panel">
      <header class="credential-dialog-head">
        <div class="min-w-0">
          <h2 id="credential-dialog-title" class="font-display text-base font-bold text-foreground sm:text-lg"></h2>
          <p class="mt-0.5 flex items-center gap-1.5 text-xs text-foreground-muted">
            <Icon name="eye-off" size="xs" />
            {hero.credentialsDialog.note}
          </p>
          <p class="credential-dialog-zoomhint mt-0.5 items-center gap-1.5 text-xs text-foreground-muted">
            <Icon name="zoom-in" size="xs" />
            {hero.credentialsDialog.zoom}
          </p>
        </div>
        <button type="button" class="credential-dialog-close" data-credential-close aria-label={hero.credentialsDialog.close}>
          <Icon name="x" size="sm" />
        </button>
      </header>
      <div class="credential-dialog-body" id="credential-dialog-pages" tabindex="0"></div>
    </div>
  </dialog>

  <!-- Focus: industrial projects, courses, software -->
  <section id="focus" class="relative z-10 py-[var(--space-section-lg)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-12">
      <div class="section-head" data-reveal>
        <div>
          <p class="section-eyebrow"><span class="section-eyebrow-num">01</span><span>{servicesSection.badge}</span></p>
          <h2 class="font-display text-3xl md:text-4xl lg:text-[2.75rem] lg:leading-[1.12] font-bold tracking-tight text-foreground">
            {servicesSection.heading}
          </h2>
        </div>
        <p class="section-lead">{servicesSection.lead}</p>
      </div>

      {/* Subgrid: the four rows of each card (header, title, text, list) line up
          across the three cards, whatever the length of the copy. */}
      <div class="grid gap-6 md:grid-cols-3 md:gap-y-0 md:grid-rows-[repeat(4,auto)]">
        {servicesSection.cards.map((card, i) => (
          <article class="focus-card md:row-span-4 md:grid md:grid-rows-subgrid md:gap-y-5 flex flex-col gap-5" data-reveal data-reveal-delay={i || undefined}>
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-xs font-semibold tracking-[0.2em] text-brand-600">{`0${i + 1}`}</span>
              <span class="rounded-full border border-border bg-background-secondary px-3 py-1 text-xs font-medium text-foreground-muted">
                {servicesSection.status}
              </span>
            </div>
            <div class="flex items-center gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-700 text-white shadow-sm">
                <Icon name={card.icon} size="md" />
              </span>
              <h3 class="font-display text-xl font-bold leading-tight text-foreground">
                {card.href ? <a href={localizedPath(card.href, locale)} class="hover:text-brand-700 hover:underline underline-offset-4">{card.title}</a> : card.title}
              </h3>
            </div>
            <p class="text-foreground-muted leading-relaxed">{card.description}</p>
            <ul class="flex flex-col gap-2.5 border-t border-border pt-5 text-sm text-foreground-muted" role="list">
              {card.points.map((point) => (
                <li class="flex items-start gap-2.5">
                  <Icon name="check" size="sm" class="mt-0.5 shrink-0 text-brand-600" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="flex justify-center" data-reveal>
        <Button size="lg" href={contactUrl}>
          {servicesSection.learnMore}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Why work with an engineer: a dark band, to break the rhythm of the page -->
  <section class="why-band invert-section relative z-10 overflow-hidden py-[var(--space-section-lg)] border-t border-border">
    <div class="relative mx-auto max-w-6xl px-6 flex flex-col gap-12">
      <div class="section-head" data-reveal>
        <div>
          <p class="section-eyebrow"><span class="section-eyebrow-num">02</span><span>{workWithMe.badge}</span></p>
          <h2 class="font-display text-3xl md:text-4xl lg:text-[2.75rem] lg:leading-[1.12] font-bold tracking-tight text-foreground">
            {workWithMe.heading}
          </h2>
        </div>
        <p class="section-lead">{workWithMe.lead}</p>
      </div>

      <div class="why-grid grid sm:grid-cols-2 lg:grid-cols-4">
        {workWithMe.cards.map((card, i) => (
          <div class="why-cell flex flex-col gap-4 p-7" data-reveal data-reveal-delay={i || undefined}>
            <div class="flex items-center justify-between">
              <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-white/10 text-white ring-1 ring-white/15">
                <Icon name={card.icon} size="md" />
              </span>
              <span class="font-mono text-xs font-semibold tracking-[0.2em] text-white/45">{`0${i + 1}`}</span>
            </div>
            <h3 class="font-display text-lg font-bold text-foreground">{card.title}</h3>
            <p class="text-sm leading-relaxed text-foreground-muted">{card.description}</p>
          </div>
        ))}
      </div>

      <div class="flex justify-center" data-reveal>
        <Button size="lg" href={servicesUrl} class="cta-btn-brand">
          {workWithMe.cta}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  <!-- About Teaser -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-10 glitch:grid-cols-2 glitch:gap-12">
        <div class="flex flex-col justify-center sm:items-center sm:text-center glitch:items-start glitch:text-left" data-reveal data-reveal-ease="smooth">
          <div class="flex flex-col gap-6 mb-6 sm:items-center glitch:items-start">
            <p class="section-eyebrow !mb-0 sm:justify-center glitch:justify-start"><span class="section-eyebrow-num">03</span><span>{aboutTeaser.badge}</span></p>
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              {aboutTeaser.headingLine1}<br />
              <span class="text-brand-500">{aboutTeaser.headingLine2}</span>
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed mb-4 sm:mb-0 sm:max-w-xl glitch:mb-4 glitch:max-w-none">
           {aboutPara1}
          </p>
          <p class="text-lg text-foreground-muted leading-relaxed mb-8 sm:max-w-xl glitch:max-w-none sm:hidden glitch:block">
           {aboutTeaser.para2}
          </p>
           <Button variant="brand-outline" href={aboutUrl} class="self-start sm:self-center glitch:self-start sm:hidden glitch:inline-flex">
            {aboutTeaser.moreAboutMe}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
        {/* A fact sheet, in the manner of a datasheet: a status line, three headline
            figures, then a table of facts. The figures are the first word of the
            stat strings, so each language keeps its own number format
            ("1,000+" / "1.000+"). The look is in sassify.css (.fact-sheet). */}
        <div class="fact-sheet flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-lg" data-reveal data-reveal-delay="1" data-reveal-ease="smooth">
          <div class="fact-sheet-head flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-border px-6 py-3">
            <p class="flex items-center gap-3 font-mono text-[11px] font-semibold uppercase tracking-widest text-foreground-secondary">
              <Icon name="user" size="sm" class="text-brand-700" />
              {aboutTeaser.statsIntro}
            </p>
            <p class="flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-foreground-secondary">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--cta)] opacity-60"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--cta)]"></span>
              </span>
              {hero.badge}
            </p>
          </div>
          <dl class="fact-sheet-figures grid grid-cols-3 divide-x divide-border border-b border-border sm:grid-cols-[1fr_1.25fr_1fr]">
            {[splitStat(aboutTeaser.stat1), splitStat(aboutTeaser.stat2), splitStat(aboutTeaser.stat4)].map((fact) => (
              <div class="flex min-w-0 flex-col justify-start gap-2 px-3 py-5 max-sm:items-center max-sm:text-center sm:justify-center sm:px-5 sm:py-7">
                <dd class="whitespace-nowrap font-display text-2xl font-extrabold leading-none text-brand-700 sm:text-3xl">{fact.value}</dd>
                <dt class="text-[11px] font-medium leading-snug text-foreground-muted hyphens-auto break-words sm:text-sm">{fact.label}</dt>
              </div>
            ))}
          </dl>
          <ul class="flex flex-1 flex-col divide-y divide-border" role="list">
            {[
              aboutTeaser.facts[0],
              aboutTeaser.facts[1],
              { icon: 'map-pin', label: aboutTeaser.basedIn, value: basedInDisplay },
              aboutTeaser.facts[2],
              aboutTeaser.facts[3],
            ].map((row) => (
              <li class="flex flex-1 items-center gap-4 px-6 py-3.5">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-700">
                  <Icon name={row.icon} size="sm" />
                </span>
                <span class="flex min-w-0 flex-col">
                  <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-foreground-subtle">{row.label}</span>
                  <span class="font-display text-[15px] font-bold leading-snug text-foreground">{row.value}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div class="hidden sm:flex justify-center glitch:hidden" data-reveal data-reveal-delay="2">
          <Button variant="brand-outline" href={aboutUrl}>
            {aboutTeaser.moreAboutMe}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Web development: a separate part of the site -->
  <section class="relative z-10 py-[var(--space-section-lg)] bg-background border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="gateway overflow-hidden rounded-3xl border border-border bg-card shadow-lg md:grid md:grid-cols-[1.15fr_1fr]" data-reveal>
        <div class="flex flex-col justify-center gap-5 p-8 sm:p-12">
          <p class="section-eyebrow !mb-0"><span class="section-eyebrow-num">04</span><span>{webGateway.badge}</span></p>
          <h2 class="font-display text-3xl font-bold tracking-tight text-foreground text-balance">
            {webGateway.heading}
          </h2>
          <p class="text-lg text-foreground-muted leading-relaxed">
            {webGateway.lead}
          </p>
          <Button variant="brand-outline" href={webUrl} class="mt-2 self-start">
            {webGateway.cta}
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
        <ul class="gateway-panel flex flex-col justify-center gap-3 border-t border-border p-8 sm:p-12 md:border-l md:border-t-0" role="list">
          {webGateway.items.map((item, i) => (
            <li class="flex items-center gap-4 rounded-xl border border-border bg-card px-4 py-4 shadow-sm">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-700">
                <Icon name={['layout', 'code', 'trending-up'][i] ?? 'check'} size="md" />
              </span>
              <span class="flex-1 font-display text-base font-bold text-foreground">{item}</span>
              <span class="font-mono text-xs font-semibold tracking-[0.2em] text-brand-600">{`0${i + 1}`}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Blog: engineering posts only -->
  {posts.length > 0 && (
  <section class="relative z-10 py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-6 text-center" data-reveal>
        <Badge variant="brand" pill>
          <Icon name="book" size="sm" />
          {blogSection.badge}
        </Badge>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
          {blogSection.heading}
        </h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, index) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={getPostUrl(post.id, post.data.locale)}
            publishedAt={post.data.publishedAt}
            tags={post.data.tags}
            author={post.data.author}
            image={post.data.image}
            svgSlug={post.data.svgSlug}
            body={post.body}
            revealDelay={index}
            class={index === 3 ? 'hidden sm:block lg:hidden' : undefined}
          />
        ))}
      </div>

      <div class="flex justify-center">
        <Button variant="brand-outline" href={blogUrl}>
          {blogSection.viewAll}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>
  )}

 <!-- CTA — `background` so it alternates with the `secondary` Blog section above.
      desktopOnly={false}: this band runs the LetterGlitch canvas at every viewport, not just
      `glitch:` (1024px, fine pointer) — the slot's own glass card keeps the copy legible either way. -->
  <section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
    <LetterGlitchBand desktopOnly={false}>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        {cta.heading}
      </h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">
        {cta.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button size="lg" href={contactUrl}>
          {cta.primary}
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" class="cta-btn-brand" href={aboutUrl}>
          {cta.secondary}
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </LetterGlitchBand>
  </section>

<script>
  // Credential cards open a viewer with the redacted scan of the document.
  function initCredentialDialog() {
    const dialog = document.getElementById('credential-dialog') as HTMLDialogElement | null;
    const pages = document.getElementById('credential-dialog-pages');
    const title = document.getElementById('credential-dialog-title');
    if (!dialog || !pages || !title || dialog.dataset.init) return;
    dialog.dataset.init = 'true';

    document.querySelectorAll<HTMLButtonElement>('[data-credential]').forEach((card) => {
      card.addEventListener('click', () => {
        const images: string[] = JSON.parse(card.dataset.images ?? '[]');
        title.textContent = card.dataset.title ?? '';
        pages.replaceChildren(
          ...images.map((src, i) => {
            const img = document.createElement('img');
            img.src = src;
            img.alt = images.length > 1 ? `${card.dataset.alt} (${i + 1}/${images.length})` : (card.dataset.alt ?? '');
            img.loading = i === 0 ? 'eager' : 'lazy';
            img.decoding = 'async';
            img.className = 'credential-dialog-page';
            img.addEventListener('click', () => img.classList.toggle('is-zoomed'));
            return img;
          })
        );
        // The description follows the documents, as the last item of the scroll area.
        if (card.dataset.description) {
          const note = document.createElement('p');
          note.className = 'credential-dialog-note';
          note.textContent = card.dataset.description;
          pages.append(note);
        }
        pages.scrollTop = 0;
        card.dataset.seen = 'true';
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-credential-close]')?.addEventListener('click', () => dialog.close());
    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
  initCredentialDialog();

  // Muted loop is the preview; the button restarts the video with sound.
  // Visitors who prefer reduced motion get the poster still until they press it.
  function initHeroVideo() {
    const video = document.querySelector<HTMLVideoElement>('.hero-video-el');
    const button = document.querySelector<HTMLButtonElement>('.hero-video-play');
    if (!video || !button) return;
    // The poster is the first paint. The muted loop starts once the page has
    // loaded, so its 3 MB does not compete with the CSS and fonts the first
    // paint waits on. Visitors who prefer reduced motion keep the poster.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const start = () => {
        const play = () => void video.play().catch(() => {});
        if ('requestIdleCallback' in window) requestIdleCallback(play, { timeout: 2000 });
        else setTimeout(play, 500);
      };
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    }
    button.addEventListener('click', () => {
      video.muted = false;
      video.loop = false;
      video.controls = true;
      video.currentTime = 0;
      void video.play();
      button.hidden = true;
    });
  }
  initHeroVideo();

  function initCountup() {
    const counters = document.querySelectorAll<HTMLElement>('[data-countup]:not([data-countup-init])');
    if (counters.length === 0) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.countup ?? '0', 10);
        const suffix = el.dataset.suffix ?? '';
        const duration = 1200;
        const start = performance.now();
        const tick = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(eased * target) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    counters.forEach((el) => {
      el.dataset.countupInit = 'true';
      observer.observe(el);
    });
  }

  initCountup();
</script>

<style is:global>
  /* Credential viewer. A native <dialog>, so focus is trapped, Escape closes it
     and focus returns to the card that opened it. */
  .credential-dialog {
    margin: auto;
    width: min(56rem, calc(100% - 1.5rem));
    max-height: min(92dvh, 60rem);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-card);
    color: var(--color-foreground);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.45);
    overflow: hidden;
  }
  .credential-dialog[open] {
    display: flex;
  }
  .credential-dialog::backdrop {
    background: color-mix(in srgb, oklch(18% 0.05 252) 70%, transparent);
    backdrop-filter: blur(4px);
  }
  .credential-dialog-panel {
    display: flex;
    min-height: 0;
    width: 100%;
    flex-direction: column;
  }
  .credential-dialog-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background-secondary);
  }
  .credential-dialog-close {
    display: inline-flex;
    height: 2.25rem;
    width: 2.25rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .credential-dialog-close:hover {
    background: var(--color-background-tertiary);
  }
  .credential-dialog-body {
    display: flex;
    min-height: 0;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 1rem;
    overflow: auto;
    padding: 1rem;
    background: color-mix(in srgb, var(--color-brand-900) 10%, var(--color-background-secondary));
  }
  .credential-dialog-page {
    display: block;
    /* The whole page fits the width on every screen. Tapping it enlarges it
       (see .is-zoomed) and the viewer scrolls in both directions. */
    width: 100%;
    height: auto;
    flex-shrink: 0;
    cursor: zoom-in;
    border-radius: 0.375rem;
    background: #fff;
    box-shadow: 0 6px 24px -8px rgb(0 0 0 / 0.35), 0 0 0 1px rgb(0 0 0 / 0.08);
  }
  .credential-dialog-page.is-zoomed {
    width: max(200%, 44rem);
    max-width: none;
    cursor: zoom-out;
  }
  /* The tap hint only makes sense where the page is narrower than a sheet of paper. */
  .credential-dialog-zoomhint {
    display: none;
  }
  @media (max-width: 767px) {
    .credential-dialog-zoomhint {
      display: flex;
    }
  }
  .credential-dialog-note {
    flex-shrink: 0;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-brand-600);
    border-radius: 0.5rem;
    background: var(--color-card);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-foreground-secondary);
  }
  html:has(.credential-dialog[open]) {
    overflow: hidden;
  }

  /* A quiet cue that the credential cards open a document: every four seconds a
     soft ring spreads from the icon and the icon leans in once. It stops on
     hover, on focus, and for good once the card has been opened, and it does not
     run at all for visitors who prefer reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .credential-card:not([data-seen]):not(:hover):not(:focus-visible) .credential-cue {
      animation: credential-nudge 4s ease-in-out infinite;
    }
    .credential-card:not([data-seen]):not(:hover):not(:focus-visible) .credential-cue::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 9999px;
      border: 1.5px solid var(--color-brand-500);
      opacity: 0;
      animation: credential-ring 4s ease-out infinite;
    }
    li:nth-child(2) > .credential-card:not([data-seen]):not(:hover):not(:focus-visible) .credential-cue,
    li:nth-child(2) > .credential-card:not([data-seen]):not(:hover):not(:focus-visible) .credential-cue::after {
      animation-delay: 2s;
    }
  }
  @keyframes credential-nudge {
    0%, 70%, 100% { transform: translateX(0) scale(1); }
    78% { transform: translateX(3px) scale(1.12); }
    86% { transform: translateX(0) scale(1); }
  }
  @keyframes credential-ring {
    0%, 70% { transform: scale(1); opacity: 0; }
    74% { opacity: 0.55; }
    100% { transform: scale(1.9); opacity: 0; }
  }

  /* Widen the homepage hero description from md upward so the paragraph
     reads on two lines instead of three on landscape phones, tablets,
     and all laptop/desktop sizes. Scoped via the unique
     .hero-dark-gradient class so other heroes keep the default
     max-w-xl reading measure. */
  @media (min-width: 768px) {
    .hero-dark-gradient .hero-title-slot + div {
      max-width: 48rem;
    }
  }

  /* ── Homepage hero tech-stack marquee ──────────────────────────────────────
     A decorative tech-stack strip floored into the hero in place of the scroll
     indicator. It must stay secondary to the H1 / description / CTAs, so we strip
     the card "box" (brand border, glow ring, panel surface) and let the
     brand-coloured logos float on the hero gradient as light accents. The logos
     keep their brand colour and soft chip; only the surrounding chrome is removed. */
  .hp-hero-marquee .stack-marquee-item > * {
    background: transparent;   /* drop the card panel */
    border-color: transparent; /* drop the brand border */
    box-shadow: none;          /* drop the brand glow ring */
    padding-left: var(--space-3);  /* tighter now there's no box, so logos sit closer */
    padding-right: var(--space-3);
  }
  /* Lighter, calmer tool names so the colourful logos lead the eye. */
  .hp-hero-marquee .stack-marquee-item .font-display {
    font-weight: 500;
    color: var(--color-foreground-muted);
  }

  /* Floored into the hero: the marquee is the section's last flex child, pushed to
     the floor (mt-auto, in Hero.astro). The CONTENT stays at the top and the
     leftover hero height opens up BETWEEN the CTAs and the marquee — the roomy
     "Chrome look". The section's column `gap` (--hero-floor-gap) is a GUARANTEED
     MINIMUM gap, so on shorter windows the marquee can never crowd the buttons;
     taller windows simply get more room. padding-bottom is the breathing room
     beneath it. */
  section.hero-dark-gradient {
    --hero-floor-gap: var(--space-16); /* 4rem — minimum gap above the marquee */
    padding-bottom: var(--space-16); /* 4rem — breathing room below it */
  }
  .hp-hero-marquee {
    pointer-events: none; /* decorative; never intercepts taps */
  }

  /* Entrance: the marquee sits outside the content stagger container, so it fades
     in on its own once the hero has settled (a vertical slide would fight the
     logos' horizontal scroll). */
  @media (prefers-reduced-motion: no-preference) {
    .hp-hero-marquee {
      animation: hp-hero-marquee-fade 0.6s ease-out 1.2s backwards;
    }
  }
  @keyframes hp-hero-marquee-fade {
    from { opacity: 0.01; }
    to   { opacity: 1; }
  }

  /* Hidden on phones — portrait (width) and landscape (short + coarse pointer),
     matching the tech-stack section's behaviour. Shown from tablet up. */
  @media (max-width: 767px) {
    .hp-hero-marquee { display: none; }
  }
  @media (orientation: landscape) and (max-height: 500px) and (pointer: coarse) {
    .hp-hero-marquee { display: none; }
  }

  /* Portrait-phone static stack logos — the lightweight counterpart to the
     marquee. Hidden by default and shown only on portrait phones, exactly where
     the marquee is hidden. A centered, non-interactive row: no links and no
     animation loop, so it costs nothing after paint. */
  .hp-hero-logos {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    pointer-events: none;
  }
  @media (max-width: 767px) and (orientation: portrait) {
    .hp-hero-logos { display: flex; padding-bottom: 2rem; }
  }

  .hp-hero-logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    color: var(--color-brand-500);
    background: color-mix(in oklch, var(--color-brand-500) 12%, transparent);
  }

  /* One-time fade-in only (reuses the marquee's keyframe); nothing loops. */
  @media (prefers-reduced-motion: no-preference) {
    .hp-hero-logos {
      animation: hp-hero-marquee-fade 0.6s ease-out 1.2s backwards;
    }
  }
</style>

</LandingLayout>
