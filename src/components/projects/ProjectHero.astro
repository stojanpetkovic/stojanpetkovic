---
import type { ImageMetadata } from 'astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import HeroGrid from '@/components/effects/HeroGrid.astro';
import HeroBeam from '@/components/effects/HeroBeam.astro';
import ProjectCarousel from '@/components/projects/ProjectCarousel.astro';
import type { GallerySlide } from '@/lib/gallery';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import { t, getLocaleFromPath } from '@/i18n';

/**
 * Project header, laid out like the Web page: an eyebrow, the title and the
 * description on the left, a small fact panel on the right, and the
 * screenshots in a quiet row underneath.
 */
interface Props {
  title: string;
  description: string;
  meta?: string[];
  client?: string;
  role?: string;
  year?: number;
  url?: string;
  repo?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  gallery?: GallerySlide[];
  tags?: string[];
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  title,
  description,
  meta = [],
  client,
  role,
  year,
  url,
  repo,
  image,
  imageAlt,
  gallery = [],
  breadcrumbs = [],
} = Astro.props;

const slides: GallerySlide[] =
  gallery.length > 0 ? gallery : image ? [{ src: image, alt: imageAlt || title }] : [];

const locale = getLocaleFromPath(Astro.url.pathname);
const primary = [
  { label: t('projects.metaClient', locale), value: client },
  { label: t('projects.metaRole', locale), value: role },
  { label: t('projects.metaYear', locale), value: year ? String(year) : undefined },
].filter((f) => f.value);
---

<header class="project-hero relative isolate overflow-hidden border-b border-border pb-14 pt-4">
  <HeroGrid />
  <HeroBeam />

  {breadcrumbs.length > 0 && (
    <div class="relative z-10 mx-auto max-w-6xl px-6 pt-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  )}

  <div class="relative z-10 mx-auto mt-8 grid max-w-6xl items-center gap-10 px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-14">
   <div class="min-w-0">
    <h1 class="font-display text-3xl font-bold tracking-tight text-foreground text-balance sm:text-[2.5rem] sm:leading-[1.15]">
      {title}
    </h1>
    <p class="mt-4 text-base leading-relaxed text-foreground-muted md:text-lg">{description}</p>

    {(url || repo) && (
      <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
        {url && (
          <Button href={url} target="_blank" rel="noopener noreferrer">
            {t('projects.viewLiveSite', locale)}
            <Icon name="external-link" size="sm" />
          </Button>
        )}
        {repo && (
          <a href={repo} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-foreground-muted underline-offset-4 hover:text-foreground hover:underline">
            {t('projects.viewSource', locale)}
          </a>
        )}
      </div>
    )}

    {(client || role || year || meta.length > 0) && (
      <div class="mt-10 overflow-hidden rounded-xl border border-border bg-card/80 shadow-sm backdrop-blur-sm">
        <dl class="grid grid-cols-[1.2fr_1.6fr_0.6fr] divide-x divide-border">
          {primary.map((f) => (
            <div class="px-4 py-3.5 sm:px-5">
              <dt class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-foreground-subtle">{f.label}</dt>
              <dd class="mt-1 text-sm font-semibold leading-snug text-foreground">{f.value}</dd>
            </div>
          ))}
        </dl>
        {meta.length > 0 && (
          <div class="border-t border-border bg-background-secondary/70 px-4 py-3.5 sm:px-5">
            <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-foreground-subtle">{t('projects.metaHighlights', locale)}</p>
            <ul class="mt-2 grid gap-x-6 gap-y-1.5 text-sm text-foreground" role="list">
              {meta.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="mt-[0.55em] h-1.5 w-1.5 shrink-0 rounded-full bg-brand-600" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
   </div>

    {slides.length > 0 && (
      <div class="min-w-0">
        <ProjectCarousel slides={slides} label={`${title} screenshots`} />
      </div>
    )}
  </div>
</header>

<style>
  /* Soft brand wash from the top-right, fading to the page colour, so the
     grid and beam sit on a surface rather than on flat white. */
  .project-hero {
    background:
      radial-gradient(60rem 28rem at 85% -10%, color-mix(in oklab, var(--color-brand-500) 14%, transparent), transparent 70%),
      radial-gradient(40rem 24rem at 0% 100%, color-mix(in oklab, var(--color-brand-500) 7%, transparent), transparent 70%),
      linear-gradient(to bottom, var(--color-background-secondary), var(--color-background));
  }
</style>
