---
/**
 * A quiet "trusted by" strip: a small caption and two figures over two rows of
 * client logos drifting in opposite directions, greyscale until hovered, faded and blurred at the edges
 * of the content width. Each row is duplicated once so the loop is seamless;
 * the copies are hidden from assistive tech, and with reduced motion one row
 * sits still and wraps instead.
 */
import { Image } from 'astro:assets';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { clients, type Client } from '@/config/clients';
import { t } from '@/i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const C = (key: string) => t(`pages.home.clients.${key}`, locale);

// Both rows carry every client, the second starting halfway through the list,
// so each row is wider than the content and the loop never shows a gap.
const half = Math.ceil(clients.length / 2);
const rows: Client[][] = [clients, [...clients.slice(half), ...clients.slice(0, half)]];
---

<section class="client-logos relative z-10 border-t border-border bg-background-secondary py-12 md:py-16" aria-labelledby="client-logos-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 id="client-logos-heading" class="text-center font-mono text-xs font-semibold uppercase tracking-[0.2em] text-foreground-subtle">{C('heading')}</h2>
    <p class="mt-3 flex flex-wrap items-baseline justify-center gap-x-5 gap-y-1 text-sm text-foreground-muted">
      <span><strong class="font-display text-lg font-bold text-brand-600 dark:text-brand-400">{clients.length}+</strong> {C('brands')}</span>
      <span class="text-border" aria-hidden="true">|</span>
      <span><strong class="font-display text-lg font-bold text-brand-600 dark:text-brand-400">2</strong> {C('countries')}</span>
    </p>

    <div class="cl-viewport relative mt-8 space-y-6 overflow-hidden">
      <span class="cl-edge cl-edge-l" aria-hidden="true"></span>
      <span class="cl-edge cl-edge-r" aria-hidden="true"></span>
      {rows.map((row, r) => (
      <div class:list={['cl-track', r === 1 && 'cl-reverse']} aria-hidden={r === 1 ? 'true' : undefined}>
        {[0, 1].map((copy) => (
          <ul class="cl-row" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {row.map((c) => (
              <li>
                <a
                  href={c.url}
                  target="_blank"
                  rel="noopener"
                  tabindex={copy === 1 || r === 1 ? -1 : undefined}
                  class="cl-item"
                  aria-label={`${c.name}: ${C('visit')}`}
                >
                  {c.logo ? (
                    <Image src={c.logo} alt="" height={120} class="cl-img" loading="lazy" />
                  ) : (
                    <span class="cl-mark">
                      <Icon name={c.icon} size="md" class="cl-ico" />
                      <span class="flex flex-col items-start leading-none">
                        <span class="cl-name">{c.name}</span>
                        {c.tagline && <span class="cl-tag">{c.tagline}</span>}
                      </span>
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cl-viewport {
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }
  .cl-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 14%;
    pointer-events: none;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .cl-edge-l {
    left: 0;
    mask-image: linear-gradient(to right, #000, transparent);
    -webkit-mask-image: linear-gradient(to right, #000, transparent);
  }
  .cl-edge-r {
    right: 0;
    mask-image: linear-gradient(to left, #000, transparent);
    -webkit-mask-image: linear-gradient(to left, #000, transparent);
  }
  .cl-track {
    display: flex;
    width: max-content;
    animation: cl-scroll 45s linear infinite;
  }
  .cl-reverse { animation-direction: reverse; animation-duration: 52s; }
  .cl-viewport:hover .cl-track { animation-play-state: paused; }
  .cl-row {
    display: flex;
    align-items: center;
    gap: 3.5rem;
    padding-right: 3.5rem;
  }
  @keyframes cl-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .cl-item {
    display: flex;
    align-items: center;
    height: 3.5rem;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 200ms, opacity 200ms;
  }
  .cl-item:hover,
  .cl-item:focus-visible { filter: none; opacity: 1; }
  .cl-img { height: 3rem; width: auto; max-width: 10rem; object-fit: contain; }
  .cl-mark { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-foreground); }
  .cl-ico { color: var(--color-foreground-muted); flex-shrink: 0; }
  .cl-name {
    font-family: var(--font-display, inherit);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .cl-tag {
    margin-top: 0.3rem;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .cl-track { animation: none; width: auto; justify-content: center; }
    .cl-track > .cl-row[aria-hidden],
    .cl-track.cl-reverse { display: none; }
    .cl-row { flex-wrap: wrap; justify-content: center; padding-right: 0; gap: 2rem 2.5rem; }
    .cl-viewport { mask-image: none; }
    .cl-edge { display: none; }
    .cl-item { transition: none; }
  }
</style>
