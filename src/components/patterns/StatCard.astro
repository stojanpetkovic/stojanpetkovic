---
/**
 * StatCard Pattern
 * Composition example: Card + typography for a metric display.
 * Common in dashboards and landing pages.
 */
import { cn } from '@/lib/cn';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  label: string;
  value: string;
  /** Optional trend indicator: 'up' | 'down' | 'neutral' */
  trend?: 'up' | 'down' | 'neutral';
  /** Trend description text (e.g., "+12% from last month") */
  trendText?: string;
  /** Icon name from the Icon component */
  icon?: string;
  /** Tighter padding and smaller figure, for supporting numbers. */
  compact?: boolean;
  class?: string;
}

const {
  label,
  value,
  trend,
  trendText,
  icon,
  compact = false,
  class: className,
} = Astro.props;

const trendColors = {
  up: 'text-[var(--success-strong)]',
  down: 'text-[var(--error-strong)]',
  neutral: 'text-foreground-muted',
};

const trendIcons = {
  up: 'trending-up',
  down: 'trending-down',
  neutral: 'minus',
};
---

<Card variant="default" padding={compact ? 'sm' : 'md'} hover={!compact} class={className}>
  <div class:list={['flex items-start justify-between', compact && 'h-full']}>
    <div class:list={[compact && 'flex h-full flex-col justify-between gap-2']}>
      <p class={cn('text-foreground-muted', compact ? 'text-xs leading-snug' : 'text-sm')}>{label}</p>
      <p class={cn('font-bold text-foreground', compact ? 'text-xl' : 'mt-1 text-2xl')}>{value}</p>
      {trend && trendText && (
        <div class={cn('flex items-center gap-1 mt-2 text-xs font-medium', trendColors[trend])}>
          <Icon name={trendIcons[trend]} size="xs" />
          <span>{trendText}</span>
        </div>
      )}
    </div>
    {icon && !compact && (
      <div class="p-2.5 rounded-lg bg-secondary text-foreground-muted">
        <Icon name={icon} size="md" />
      </div>
    )}
  </div>
</Card>
