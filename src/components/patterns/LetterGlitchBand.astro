---
/**
 * LetterGlitchBand — the closing call-to-action band.
 *
 * It used to run an animated letter canvas with a cartoon avatar beside the
 * copy. It now renders the same `CtaBand` as the rest of the site, so every
 * page closes with one serious, static band. The name and props are kept so
 * the pages that use it need no edits.
 */
import CtaBand from './CtaBand.astro';

interface Props {
  maxWidth?: '6xl' | '7xl';
  /** Show the band from the `glitch:` breakpoint (1024px, fine pointer) up only. */
  desktopOnly?: boolean;
}

const { maxWidth = '6xl', desktopOnly = true } = Astro.props;
---

<div class={desktopOnly ? 'hidden glitch:block' : 'block'}>
  <CtaBand maxWidth={maxWidth}>
    <slot />
  </CtaBand>
</div>
