---
export const prerender = false;
import '@/admin/styles/admin.css';
import { Icon } from 'astro-icon/components';
import ReportChart from '@/admin/components/ReportChart.astro';
import { db } from '@/admin/lib/supabase';
import { analyzeDays, type ReportLocale } from '@/admin/lib/analytics';
import { leadSource } from '@/admin/lib/leads';
import { dayKey } from '@/admin/lib/stats';
import {
  T,
  periods,
  pickPeriod,
  channelLabel,
  formatNumber,
  formatRate,
  changeText,
  summaryOf,
  parseSpend,
  spendMetrics,
  formatMoney,
  CURRENCIES,
} from '@/admin/lib/report';
import type { Lead, Site } from '@/admin/lib/types';

const { id } = Astro.params;
const { data: site } = await db().from('sites').select('*').eq('id', id!).maybeSingle<Site>();
if (!site) return Astro.redirect('/admin/sites');

// The client's language by default (the site's email language); ?lang= overrides it.
const langParam = Astro.url.searchParams.get('lang');
const locale: ReportLocale = langParam === 'en' || langParam === 'sr' ? langParam : site.email_language;
const t = T[locale];

const params = Astro.url.searchParams;
const all = periods(site.timezone, locale);
const period = pickPeriod(all, params.get('period'), {
  from: params.get('from'),
  to: params.get('to'),
  timeZone: site.timezone,
  locale,
});
// Asked for a custom period, got the default: the dates were not usable.
const customRejected = params.get('period') === 'custom' && period.key !== 'custom';
const analytics = await analyzeDays(site, period.current, period.previous, locale);

const inPeriod = new Set(period.current);
const { data: leadData } = await db()
  .from('leads')
  .select('created_at, visitor_name, visitor_email, form_name, utm_source, utm_medium, referrer, status')
  .eq('site_id', site.id)
  .eq('is_spam', false)
  .gte('created_at', new Date(Date.parse(`${period.current[0]}T00:00:00Z`) - 86_400_000).toISOString())
  .lt('created_at', new Date(Date.parse(`${period.current.at(-1)}T00:00:00Z`) + 2 * 86_400_000).toISOString())
  .order('created_at', { ascending: true });
const leads = ((leadData ?? []) as Pick<
  Lead,
  'created_at' | 'visitor_name' | 'visitor_email' | 'form_name' | 'utm_source' | 'utm_medium' | 'referrer' | 'status'
>[]).filter((l) => inPeriod.has(dayKey(new Date(l.created_at), site.timezone)));

// Spend entered on this page for the period, and what it bought.
const spend = parseSpend(params);
const won = leads.filter((l) => l.status === 'won').length;
const cost = spend ? spendMetrics(analytics, spend, won) : null;
const money = (v: number | null) => (v === null || !spend ? '—' : formatMoney(v, spend.currency, locale));

const tot = analytics.totals;
const prev = analytics.previous;
const n = (v: number) => formatNumber(v, locale);
const dateFmt = new Intl.DateTimeFormat(locale === 'en' ? 'en-US' : 'sr-Latn-RS', {
  dateStyle: 'medium',
  timeZone: site.timezone,
});
const rangeText = `${dateFmt.format(new Date(`${period.current[0]}T12:00:00Z`))} – ${dateFmt.format(new Date(`${period.current.at(-1)}T12:00:00Z`))}`;

const kpis = [
  { label: t.visitors, value: n(tot.visitors), change: changeText(tot.visitors, prev.visitors, locale), icon: 'lucide:users', tint: 'bg-success/15', tile: 'bg-success' },
  { label: t.visits, value: n(tot.visits), change: changeText(tot.visits, prev.visits, locale), icon: 'lucide:mouse-pointer-click', tint: 'bg-danger/15', tile: 'bg-danger' },
  { label: t.leads, value: n(tot.leads), change: changeText(tot.leads, prev.leads, locale), icon: 'lucide:inbox', tint: 'bg-info/15', tile: 'bg-info' },
  { label: t.calls, value: n(tot.calls), change: changeText(tot.calls, prev.calls, locale), icon: 'lucide:phone', tint: 'bg-secondary/15', tile: 'bg-secondary' },
  { label: t.conversion, value: formatRate(tot.contacts, tot.visits, locale) ?? '—', change: { text: t.conversionHint, tone: 'neutral' as const }, icon: 'lucide:percent', tint: 'bg-primary/15', tile: 'bg-primary' },
];

const maxDevice = Math.max(1, ...analytics.devices.map((d) => d.count));
const maxCountry = Math.max(1, ...analytics.countries.map((c) => c.count));
const maxClick = Math.max(1, ...analytics.clicks.map((c) => c.count));
// Links that switch language keep every other setting on the page.
const qs = (overrides: Record<string, string>) => {
  const next = new URLSearchParams(params);
  next.set('period', period.key);
  for (const [key, value] of Object.entries(overrides)) next.set(key, value);
  return `?${next}`;
};
const field = (name: string) => params.get(name) ?? '';
const fileTitle = `${site.name} – ${t.title} – ${period.label}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/admin-favicon.svg" type="image/svg+xml" />
    <!-- Browsers use the title as the PDF's file name. -->
    <title>{fileTitle}</title>
  </head>
  <body class="bg-zinc-100 print:bg-white">
    <!-- Toolbar: on screen only. -->
    <div class="sticky top-0 z-10 border-b border-zinc-200 bg-white print:hidden">
      <div class="mx-auto flex max-w-[210mm] flex-wrap items-center gap-3 px-4 py-3">
        <a href={`/admin/sites/${site.id}`} class="btn btn-sm btn-light"><Icon name="lucide:arrow-left" class="size-4" />{t.back}</a>
        <form method="get" id="report-settings" class="flex w-full flex-wrap items-end gap-2 order-last">
          <input type="hidden" name="lang" value={locale} />
          <label class="text-xs text-zinc-500">
            {t.period}
            <select name="period" class="form-input mt-0.5 block w-auto py-1.5" aria-label={t.period} data-period>
              {all.map((p) => <option value={p.key} selected={p.key === period.key}>{p.label}</option>)}
              <option value="custom" selected={period.key === 'custom' || customRejected}>{t.customPeriod}</option>
            </select>
          </label>
          <label class="text-xs text-zinc-500" data-custom>
            {t.from}
            <input type="date" name="from" value={period.key === 'custom' ? period.current[0] : field('from')} class="form-input mt-0.5 block w-auto py-1.5" />
          </label>
          <label class="text-xs text-zinc-500" data-custom>
            {t.to}
            <input type="date" name="to" value={period.key === 'custom' ? period.current.at(-1) : field('to')} class="form-input mt-0.5 block w-auto py-1.5" />
          </label>
          <fieldset class="flex flex-wrap items-end gap-2 border-s border-zinc-200 ps-3" title={t.spendHint}>
            <legend class="sr-only">{t.spendHeading}</legend>
            <label class="text-xs text-zinc-500">
              {t.spendGoogle}
              <input name="spendGoogle" inputmode="decimal" value={field('spendGoogle')} placeholder="0" class="form-input mt-0.5 block w-24 py-1.5" />
            </label>
            <label class="text-xs text-zinc-500">
              {t.spendMeta}
              <input name="spendMeta" inputmode="decimal" value={field('spendMeta')} placeholder="0" class="form-input mt-0.5 block w-24 py-1.5" />
            </label>
            <label class="text-xs text-zinc-500">
              {t.spendOther}
              <input name="spendOther" inputmode="decimal" value={field('spendOther')} placeholder="0" class="form-input mt-0.5 block w-24 py-1.5" />
            </label>
            <label class="text-xs text-zinc-500">
              {t.currency}
              <select name="currency" class="form-input mt-0.5 block w-auto py-1.5">
                {CURRENCIES.map((c) => <option value={c} selected={(spend?.currency ?? (field('currency') || 'EUR')) === c}>{c}</option>)}
              </select>
            </label>
            <label class="text-xs text-zinc-500">
              {t.jobValue} <span class="text-zinc-400">({t.optional})</span>
              <input name="jobValue" inputmode="decimal" value={field('jobValue')} placeholder="0" class="form-input mt-0.5 block w-28 py-1.5" />
            </label>
          </fieldset>
          <button class="btn btn-sm btn-outline" type="submit">{t.apply}</button>
          <p class="w-full text-[11px] text-zinc-400">{t.spendHint}</p>
          {customRejected && <p class="w-full text-xs text-orange-700">{t.invalidPeriod}</p>}
        </form>
        <div class="inline-flex rounded border border-zinc-200 p-0.5 text-xs font-medium">
          <a href={qs({ lang: 'sr' })} class:list={['rounded px-2.5 py-1', locale === 'sr' ? 'bg-primary text-white' : 'text-zinc-600 hover:bg-zinc-100']}>SR</a>
          <a href={qs({ lang: 'en' })} class:list={['rounded px-2.5 py-1', locale === 'en' ? 'bg-primary text-white' : 'text-zinc-600 hover:bg-zinc-100']}>EN</a>
        </div>
        <button type="button" class="btn btn-sm btn-primary ms-auto" onclick="window.print()">
          <Icon name="lucide:download" class="size-4" />{t.print}
        </button>
      </div>
    </div>

    <!-- The sheet: A4 width on screen, the whole page in print. -->
    <article class="report-sheet mx-auto my-6 max-w-[210mm] space-y-6 bg-white p-5 shadow-sm sm:p-10 print:m-0 print:max-w-none print:space-y-4 print:p-0 print:shadow-none">
      <header class="flex flex-wrap items-start justify-between gap-6 border-b border-zinc-200 pb-6 print:flex-nowrap print:pb-4">
        <div>
          <p class="text-xs font-bold tracking-widest text-primary uppercase">{t.title}</p>
          <h1 class="mt-1 text-2xl font-semibold text-zinc-900">{site.name}</h1>
          <p class="mt-1 text-sm text-zinc-500">{site.domain}</p>
        </div>
        <div class="text-end text-sm">
          <p class="text-zinc-500">{t.period}</p>
          <p class="font-semibold text-zinc-800">{period.label}</p>
          <p class="text-xs text-zinc-500">{rangeText}</p>
          {site.client_name && <p class="mt-2 text-xs text-zinc-500">{t.preparedFor}: <span class="font-medium text-zinc-700">{site.client_name}</span></p>}
        </div>
      </header>

      <p class="text-[15px] leading-relaxed text-zinc-700">
        {summaryOf(analytics, period.key === 'last30' ? (locale === 'en' ? 'the last 30 days' : 'poslednjih 30 dana') : period.label, locale)}
        {cost && t.costSummary({ total: money(cost.total), perContact: cost.perContact === null ? null : money(cost.perContact), won: cost.won })}
      </p>

      <section class="avoid-break grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5 print:grid-cols-5 [&>*]:min-w-0">
        {
          kpis.map((k) => (
            <div class:list={['rounded-[0.3rem] p-4', k.tint]}>
              <span class:list={['grid size-9 place-items-center rounded text-white', k.tile]}>
                <Icon name={k.icon} class="size-4.5" />
              </span>
              <div class="mt-3 text-xl font-semibold text-zinc-900">{k.value}</div>
              <div class="text-xs text-zinc-700">{k.label}</div>
              <div
                class:list={[
                  'mt-1 text-[11px] leading-snug',
                  k.change.tone === 'up' ? 'text-green-700' : k.change.tone === 'down' ? 'text-orange-700' : 'text-zinc-500',
                ]}
              >
                {k.change.text}
              </div>
            </div>
          ))
        }
      </section>


      {
        cost && (
          <section class="avoid-break space-y-4">
            <h2 class="text-base font-semibold">{t.costs}</h2>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 print:grid-cols-4 [&>*]:min-w-0">
              {[
                { label: t.totalSpend, value: money(cost.total), hint: '' },
                { label: t.perLead, value: money(cost.perLead), hint: `${n(tot.leads)} ${t.leads.toLowerCase()}` },
                { label: t.perCall, value: money(cost.perCall), hint: `${n(tot.calls)} ${t.calls.toLowerCase()}` },
                { label: t.perContact, value: money(cost.perContact), hint: t.perContactHint },
                { label: t.won, value: n(cost.won), hint: t.wonHint },
                { label: t.perWon, value: money(cost.perWon), hint: '' },
                ...(cost.revenue !== null
                  ? [
                      { label: t.revenue, value: money(cost.revenue), hint: t.revenueHint },
                      { label: t.roas, value: `${cost.roas!.toLocaleString(locale === 'en' ? 'en-US' : 'sr-Latn-RS', { maximumFractionDigits: 1 })}×`, hint: t.roasHint },
                    ]
                  : []),
              ].map((k) => (
                <div class="rounded-[0.3rem] border border-zinc-200 p-4">
                  <div class="text-xl font-semibold text-zinc-900 tabular-nums">{k.value}</div>
                  <div class="text-xs text-zinc-700">{k.label}</div>
                  {k.hint && <div class="mt-1 text-[11px] leading-snug text-zinc-500">{k.hint}</div>}
                </div>
              ))}
            </div>
            {cost.channels.length > 0 && (
              <div>
                <h3 class="mb-2 text-sm font-semibold">{t.byChannel}</h3>
                <table class="table w-full table-fixed">
                  <thead>
                    <tr><th class="w-[40%]">{t.channel}</th><th class="text-right">{t.spent}</th><th class="text-right">{t.contacts}</th><th class="text-right">{t.perContact}</th></tr>
                  </thead>
                  <tbody>
                    {cost.channels.map((c) => (
                      <tr>
                        <td>{channelLabel(c.label, locale)}</td>
                        <td class="text-right tabular-nums">{money(c.spend)}</td>
                        <td class="text-right font-semibold tabular-nums">{n(c.contacts)}</td>
                        <td class="text-right tabular-nums">{money(c.perContact)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {spend && spend.other > 0 && <p class="mt-2 text-[11px] text-zinc-500">{t.breakdownOther}</p>}
              </div>
            )}
          </section>
        )
      }

      <section class="avoid-break">
        <h2 class="mb-3 text-base font-semibold">{t.daily}</h2>
        <ReportChart
          days={analytics.daily.map((d) => ({ day: d.day, visitors: d.visitors, leads: d.leads + d.calls }))}
          labels={{ visitors: t.visitors, leads: `${t.leads} + ${t.calls.toLowerCase()}` }}
        />
      </section>

      <section class="space-y-6">
        <div class="avoid-break">
          <h2 class="mb-3 text-base font-semibold">{t.sources}</h2>
          <table class="table w-full table-fixed">
            <thead>
              <tr><th class="w-[44%]">{t.source}</th><th class="text-right">{t.visits}</th><th class="text-right">{t.leads}</th><th class="text-right">{t.calls}</th><th class="text-right">{t.rate}</th></tr>
            </thead>
            <tbody>
              {analytics.channels.length === 0 && <tr><td colspan="5" class="text-zinc-500">{t.noData}</td></tr>}
              {analytics.channels.map((c) => (
                <tr>
                  <td class="truncate" title={channelLabel(c.label, locale)}>{channelLabel(c.label, locale)}</td>
                  <td class="text-right tabular-nums">{n(c.visits)}</td>
                  <td class="text-right font-semibold tabular-nums">{c.leads}</td>
                  <td class="text-right font-semibold tabular-nums">{c.calls}</td>
                  <td class="text-right text-zinc-500 tabular-nums">{formatRate(c.leads + c.calls, c.visits, locale) ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="avoid-break">
          <h2 class="mb-3 text-base font-semibold">{t.pages}</h2>
          <table class="table w-full table-fixed">
            <thead>
              <tr><th class="w-[52%]">{t.page}</th><th class="text-right">{t.pageViews}</th><th class="text-right">{t.leads}</th><th class="text-right">{t.calls}</th></tr>
            </thead>
            <tbody>
              {analytics.pages.length === 0 && <tr><td colspan="4" class="text-zinc-500">{t.noData}</td></tr>}
              {analytics.pages.slice(0, 8).map((p) => (
                <tr>
                  <td class="truncate" title={p.label}>{p.label}</td>
                  <td class="text-right tabular-nums">{n(p.views)}</td>
                  <td class="text-right font-semibold tabular-nums">{p.leads}</td>
                  <td class="text-right font-semibold tabular-nums">{p.calls}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="space-y-6">
        {
          [
            { title: t.contactClicks, items: analytics.clicks, max: maxClick },
            { title: t.devices, items: analytics.devices, max: maxDevice },
            { title: t.countries, items: analytics.countries, max: maxCountry },
          ].map((block) => (
            <div class="avoid-break">
              <h2 class="mb-3 text-base font-semibold">{block.title}</h2>
              {block.items.length === 0 && <p class="text-sm text-zinc-500">{t.noData}</p>}
              <div class="space-y-2.5">
                {block.items.map((item) => (
                  <div>
                    <div class="flex justify-between text-[13px]">
                      <span class="text-zinc-700">{item.label}</span>
                      <span class="font-semibold tabular-nums">{n(item.count)}</span>
                    </div>
                    <div class="mt-1 h-1.5 rounded-full bg-zinc-100">
                      <div class="h-1.5 rounded-full bg-primary" style={`width:${(item.count / block.max) * 100}%`} />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </section>

      <section>
        <h2 class="mb-3 text-base font-semibold">{t.leadList} ({leads.length})</h2>
        {
          leads.length === 0 ? (
            <p class="text-sm text-zinc-500">{t.noLeads}</p>
          ) : (
            <table class="table">
              <thead>
                <tr><th>{t.date}</th><th>{t.name}</th><th>{t.source}</th><th>{t.form}</th></tr>
              </thead>
              <tbody>
                {leads.map((l) => (
                  <tr class="avoid-break">
                    <td class="whitespace-nowrap">{dateFmt.format(new Date(l.created_at))}</td>
                    <td>{l.visitor_name || l.visitor_email || '—'}</td>
                    <td>{channelLabel(leadSource(l), locale)}</td>
                    <td>{l.form_name}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
      </section>

      <footer class="space-y-1 border-t border-zinc-200 pt-3 text-[11px] text-zinc-500">
        <p>{t.notes}</p>
        {cost && <p>{t.costNotes}</p>}
        <p class="font-medium text-zinc-600">{t.footer}</p>
      </footer>
    </article>
    <script>
      // Dates matter only for a custom period; a preset applies at once.
      const settings = document.getElementById('report-settings') as HTMLFormElement | null;
      const select = settings?.querySelector<HTMLSelectElement>('[data-period]');
      const toggle = () =>
        settings?.querySelectorAll<HTMLElement>('[data-custom]').forEach((el) => (el.hidden = select?.value !== 'custom'));
      select?.addEventListener('change', () => {
        toggle();
        if (select.value !== 'custom') settings?.requestSubmit();
      });
      toggle();
    </script>
  </body>
</html>
