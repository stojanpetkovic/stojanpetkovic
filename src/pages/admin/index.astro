---
export const prerender = false;
import { Icon } from 'astro-icon/components';
import AdminLayout from '@/admin/layouts/AdminLayout.astro';
import StatCard from '@/admin/components/StatCard.astro';
import DailyChart from '@/admin/components/DailyChart.astro';
import BarList from '@/admin/components/BarList.astro';
import LeadTable from '@/admin/components/LeadTable.astro';
import { db } from '@/admin/lib/supabase';
import { dailySeries, summarize } from '@/admin/lib/stats';
import { sitesOverview, rate } from '@/admin/lib/analytics';
import type { Lead, Site } from '@/admin/lib/types';

const since = new Date(Date.now() - 60 * 86_400_000).toISOString();
const [{ data: sitesData }, { data: leadsData }] = await Promise.all([
  db().from('sites').select('*').order('name'),
  db().from('leads').select('*').eq('is_spam', false).gte('created_at', since).order('created_at', { ascending: false }),
]);

const sites = (sitesData ?? []) as Site[];
const leads = (leadsData ?? []) as Lead[];
const siteMap = new Map(sites.map((s) => [s.id, s]));
const stats = summarize(leads);

const DAYS = 30;
const labels = dailySeries([], DAYS, 'Europe/Belgrade').map((d) => d.day);
const series = sites
  .map((site) => ({
    label: site.name,
    data: dailySeries(leads.filter((l) => l.site_id === site.id), DAYS, 'Europe/Belgrade').map((d) => d.count),
  }))
  .filter((s) => s.data.some((n) => n > 0));

const overview = (await sitesOverview(sites, 30)).sort((a, b) => b.visitors - a.visitors || b.contacts - a.contacts);
const visitors30 = overview.reduce((n, o) => n + o.visitors, 0);
const changeNote =
  stats.change === null ? 'nema podataka za prethodni period' : `${stats.change >= 0 ? '+' : ''}${stats.change}% u odnosu na prethodnih 30 dana`;
---

<AdminLayout title="Kontrolna tabla">
  {sites.length === 0 && (
    <div class="card card-body flex flex-wrap items-center justify-between gap-5">
      <div>
        <h2 class="card-title">Dodaj prvi sajt</h2>
        <p class="text-muted mt-1">Svaki sajt dobija svoj ključ i jednu liniju koda koja šalje forme ovde.</p>
      </div>
      <a href="/admin/sites" class="btn btn-primary">Dodaj sajt</a>
    </div>
  )}

  <div class="grid grid-cols-2 xl:grid-cols-4 gap-5">
    <StatCard icon="lucide:calendar-check" color="success" label="Upiti danas" value={stats.today} />
    <StatCard icon="lucide:calendar-days" color="warning" label="Upiti, 7 dana" value={stats.last7} />
    <StatCard
      icon="lucide:inbox"
      color="secondary"
      label="Upiti, 30 dana"
      value={stats.last30}
      note={changeNote}
      tone={stats.change === null ? 'neutral' : stats.change >= 0 ? 'up' : 'down'}
    />
    <StatCard icon="lucide:users" color="info" label="Posetioci, 30 dana" value={visitors30.toLocaleString('sr-Latn-RS')} note={`na ${sites.filter((s) => s.active).length} aktivnih sajtova`} />
  </div>

  <DailyChart title="Lidovi po danu (30 dana)" labels={labels} series={series.length ? series : [{ label: 'Lidovi', data: labels.map(() => 0) }]} />

  <div class="grid lg:grid-cols-2 gap-5">
    <div class="card">
      <div class="card-header"><h2 class="card-title">Sajtovi, 30 dana</h2></div>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr><th>Sajt</th><th class="text-right">Posetioci</th><th class="text-right">Upiti</th><th class="text-right">Pozivi</th><th class="text-right">Stopa</th></tr>
          </thead>
          <tbody>
            {overview.length === 0 && <tr><td colspan="5" class="text-center text-muted py-6">Još nema sajtova.</td></tr>}
            {overview.map((o) => (
              <tr>
                <td><a href={`/admin/sites/${o.site.id}`} class="font-medium text-ink hover:text-primary">{o.site.name}</a></td>
                <td class="text-right tabular-nums">{o.visitors.toLocaleString('sr-Latn-RS')}</td>
                <td class="text-right tabular-nums font-semibold text-ink">{o.leads}</td>
                <td class="text-right tabular-nums font-semibold text-ink">{o.calls}</td>
                <td class="text-right tabular-nums text-muted">{rate(o.contacts, o.visits)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <BarList title="Po izvoru (60 dana)" items={stats.bySource} />
  </div>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Poslednji lidovi</h2>
      <a href="/admin/leads" class="btn btn-sm btn-soft">Svi lidovi <Icon name="lucide:move-right" class="size-4" /></a>
    </div>
    <LeadTable leads={leads.slice(0, 10)} sites={siteMap} />
  </div>
</AdminLayout>
