---
import N2VesselView from '@/components/pages/views/N2VesselView.astro';
import { getSecondaryLocales } from '@/i18n';
import { segment, toolSlug } from '@/i18n/routes';

// Locale-prefixed calculator page (`/<locale>/tools/nitrogen-vessel`, translated per locale). One page
// per non-default locale; emits nothing when i18n is off.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({
    params: { locale, tools: segment('tools', locale), nitrogenVessel: toolSlug('nitrogen-vessel', locale) },
  }));
}

const { locale } = Astro.params;
---

<N2VesselView locale={locale} />
