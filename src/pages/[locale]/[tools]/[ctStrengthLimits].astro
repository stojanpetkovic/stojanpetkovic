---
import CtStrengthView from '@/components/pages/views/CtStrengthView.astro';
import { getSecondaryLocales } from '@/i18n';
import { segment, toolSlug } from '@/i18n/routes';

// Locale-prefixed calculator page (`/<locale>/tools/ct-strength-limits`, translated per locale). One page
// per non-default locale; emits nothing when i18n is off.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({
    params: { locale, tools: segment('tools', locale), ctStrengthLimits: toolSlug('ct-strength-limits', locale) },
  }));
}

const { locale } = Astro.params;
---

<CtStrengthView locale={locale} />
