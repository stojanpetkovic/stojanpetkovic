---
import CtPressureLossView from '@/components/pages/views/CtPressureLossView.astro';
import { getSecondaryLocales } from '@/i18n';
import { segment, toolSlug } from '@/i18n/routes';

// Locale-prefixed calculator page (`/<locale>/tools/ct-pressure-loss`, translated per locale). One page
// per non-default locale; emits nothing when i18n is off.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({
    params: { locale, tools: segment('tools', locale), ctPressureLoss: toolSlug('ct-pressure-loss', locale) },
  }));
}

const { locale } = Astro.params;
---

<CtPressureLossView locale={locale} />
