---
import WellBuilderView from '@/components/pages/views/WellBuilderView.astro';
import { getSecondaryLocales } from '@/i18n';
import { segment, toolSlug } from '@/i18n/routes';

// Locale-prefixed Well Builder (`/<locale>/tools/well-builder`, translated per locale). One page per
// non-default locale; emits nothing when i18n is off.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({
    params: { locale, tools: segment('tools', locale), wellBuilder: toolSlug('well-builder', locale) },
  }));
}

const { locale } = Astro.params;
---

<WellBuilderView locale={locale} />
