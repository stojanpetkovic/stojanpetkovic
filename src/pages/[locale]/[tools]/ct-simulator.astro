---
import CtSimulatorView from '@/components/pages/views/CtSimulatorView.astro';
import { getSecondaryLocales } from '@/i18n';
import { segment } from '@/i18n/routes';

// Locale-prefixed calculator page (`/<locale>/tools/ct-simulator`, translated per locale). One page
// per non-default locale; emits nothing when i18n is off.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale, tools: segment('tools', locale) } }));
}

const { locale } = Astro.params;
---

<CtSimulatorView locale={locale} />
