---
import CoursesView from '@/components/pages/views/CoursesView.astro';
import { getSecondaryLocales } from '@/i18n';
import { segment } from '@/i18n/routes';

// Locale-prefixed Courses page (`/<locale>/courses`, translated per locale). One page
// per non-default locale; emits nothing when i18n is off.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale, courses: segment('courses', locale) } }));
}

const { locale } = Astro.params;
---

<CoursesView locale={locale} />
