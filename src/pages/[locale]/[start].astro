---
import LandingPageView from '@/components/pages/views/LandingPageView.astro';
import { getSecondaryLocales } from '@/i18n';
import { segment } from '@/i18n/routes';

// Locale-prefixed landing page (`/<locale>/start`, translated per locale). The page itself offers no
// way to switch language: each ad points at the version in its own language.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale, start: segment('start', locale) } }));
}

const { locale } = Astro.params;
---

<LandingPageView locale={locale} />
