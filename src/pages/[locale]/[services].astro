---
import ServicesView from '@/components/pages/views/ServicesView.astro';
import { getSecondaryLocales } from '@/i18n';
import { segment } from '@/i18n/routes';

// Locale-prefixed Services page (`/<locale>/services`, translated per locale). One page per non-default
// locale; emits nothing when i18n is off. Untranslated copy falls back to the
// default locale so the LanguageSwitcher never lands on a 404.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale, services: segment('services', locale) } }));
}

const { locale } = Astro.params;
---

<ServicesView locale={locale} />
