---
import WellBuilderView from '@/components/pages/views/WellBuilderView.astro';
import { getSecondaryLocales } from '@/i18n';

// Locale-prefixed Well Builder (`/<locale>/tools/well-builder`). One page per
// non-default locale; emits nothing when i18n is off.
export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<WellBuilderView locale={locale} />
