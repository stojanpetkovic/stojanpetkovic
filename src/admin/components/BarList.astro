---
// Horizontal bars drawn in CSS: readable in print and needs no JavaScript.
interface Props {
  title: string;
  items: { label: string; count: number }[];
  empty?: string;
}
const { title, items, empty = 'Još nema podataka.' } = Astro.props;
const max = Math.max(1, ...items.map((i) => i.count));
---

<div class="card">
  <div class="card-header"><h2 class="card-title">{title}</h2></div>
  <div class="card-body space-y-3">
    {items.length === 0 && <p class="text-muted">{empty}</p>}
    {items.map((item) => (
      <div>
        <div class="flex justify-between gap-3 text-[13px]">
          <span class="truncate text-zinc-700" title={item.label}>{item.label}</span>
          <span class="font-semibold text-ink tabular-nums">{item.count}</span>
        </div>
        <div class="mt-1 h-1.5 rounded-full bg-zinc-100">
          <div class="h-1.5 rounded-full bg-primary" style={`width:${(item.count / max) * 100}%`}></div>
        </div>
      </div>
    ))}
  </div>
</div>
