---
interface Series {
  label: string;
  data: number[];
  /** Drawn as a line on its own right-hand axis, for a small count beside a large one. */
  line?: boolean;
}
interface Props {
  title: string;
  labels: string[];
  series: Series[];
  note?: string;
}
const { title, labels, series, note } = Astro.props;
const id = `chart-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="card">
  <div class="card-header">
    <h2 class="card-title">{title}</h2>
    {note && <span class="text-xs text-muted">{note}</span>}
  </div>
  <div class="card-body">
    <div class="relative h-64">
      <canvas id={id} data-chart={JSON.stringify({ labels, series })} aria-label={title} role="img"></canvas>
    </div>
  </div>
</div>

<script>
  import {
    Chart,
    BarController,
    BarElement,
    LineController,
    LineElement,
    PointElement,
    CategoryScale,
    LinearScale,
    Tooltip,
    Legend,
  } from 'chart.js';
  Chart.register(
    BarController,
    BarElement,
    LineController,
    LineElement,
    PointElement,
    CategoryScale,
    LinearScale,
    Tooltip,
    Legend,
  );

  const palette = ['#3b82f6', '#8b5cf6', '#22c55e', '#f59e0b', '#0ea5e9', '#f97316', '#ec4899', '#14b8a6'];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('canvas[data-chart]')) {
    const { labels, series } = JSON.parse(canvas.dataset.chart!) as {
      labels: string[];
      series: { label: string; data: number[]; line?: boolean }[];
    };
    const hasLine = series.some((s) => s.line);
    new Chart(canvas, {
      type: 'bar',
      data: {
        labels: labels.map((d) => d.slice(8, 10) + '.' + d.slice(5, 7) + '.'),
        datasets: series.map((s, i) =>
          s.line
            ? {
                type: 'line' as const,
                label: s.label,
                data: s.data,
                yAxisID: 'y1',
                borderColor: '#22c55e',
                backgroundColor: '#22c55e',
                borderWidth: 2,
                pointRadius: 3,
                tension: 0.3,
              }
            : {
                type: 'bar' as const,
                label: s.label,
                data: s.data,
                backgroundColor: palette[i % palette.length],
                borderRadius: 3,
                maxBarThickness: 22,
              },
        ),
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: reduced ? false : undefined,
        plugins: { legend: { display: series.length > 1, position: 'bottom' } },
        scales: {
          x: { stacked: !hasLine, grid: { display: false }, ticks: { maxRotation: 0, autoSkipPadding: 12 } },
          y: { stacked: !hasLine, beginAtZero: true, ticks: { precision: 0 } },
          ...(hasLine
            ? { y1: { position: 'right' as const, beginAtZero: true, grid: { display: false }, ticks: { precision: 0 } } }
            : {}),
        },
      },
    });
  }
</script>
