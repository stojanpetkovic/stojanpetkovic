---
import { STATUS_LABELS, timeAgo, formatDateTime } from '@/admin/lib/format';
import { leadSource } from '@/admin/lib/leads';
import type { Lead, Site } from '@/admin/lib/types';

interface Props {
  leads: Lead[];
  sites: Map<string, Site>;
  showSite?: boolean;
  empty?: string;
}
const { leads, sites, showSite = true, empty = 'Još nema lidova.' } = Astro.props;
---

<div class="overflow-x-auto">
  <table class="table">
    <thead>
      <tr>
        <th>Kontakt</th>
        {showSite && <th>Sajt</th>}
        <th>Forma</th>
        <th>Izvor</th>
        <th>Status</th>
        <th>Vreme</th>
      </tr>
    </thead>
    <tbody>
      {leads.length === 0 && (
        <tr><td colspan={showSite ? 6 : 5} class="text-center text-muted py-8">{empty}</td></tr>
      )}
      {leads.map((lead) => (
        <tr>
          <td>
            <a href={`/admin/leads/${lead.id}`} class="font-medium text-ink hover:text-primary">
              {lead.visitor_name || lead.visitor_email || lead.visitor_phone || 'Bez imena'}
            </a>
            <div class="text-xs text-muted">{[lead.visitor_email, lead.visitor_phone].filter(Boolean).join(' · ')}</div>
          </td>
          {showSite && <td class="whitespace-nowrap">{sites.get(lead.site_id)?.name ?? '—'}</td>}
          <td>{lead.form_name}</td>
          <td class="whitespace-nowrap">{leadSource(lead)}</td>
          <td>
            {lead.is_spam
              ? <span class="badge badge-spam">Spam</span>
              : <span class={`badge badge-${lead.status}`}>{STATUS_LABELS[lead.status]}</span>}
          </td>
          <td class="whitespace-nowrap text-muted" title={formatDateTime(lead.created_at)}>{timeAgo(lead.created_at)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
