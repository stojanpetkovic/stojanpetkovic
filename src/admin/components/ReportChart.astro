---
// Daily visitors as bars and inquiries as a line on their own scale, drawn as
// SVG on the server so the printed PDF is sharp and needs no JavaScript.
interface Props {
  days: { day: string; visitors: number; leads: number }[];
  labels: { visitors: string; leads: string };
}
const { days, labels } = Astro.props;

const W = 1000;
const H = 240;
const pad = { top: 16, right: 36, bottom: 28, left: 36 };
const innerW = W - pad.left - pad.right;
const innerH = H - pad.top - pad.bottom;

const maxVisitors = Math.max(1, ...days.map((d) => d.visitors));
const maxLeads = Math.max(1, ...days.map((d) => d.leads));
// Four equal steps with whole-number labels, whatever the scale.
const niceMax = (n: number) => {
  if (n <= 4) return 4;
  const step = Math.pow(10, Math.floor(Math.log10(n / 4)));
  return Math.ceil(n / 4 / step) * step * 4;
};
const vMax = niceMax(maxVisitors);
const lMax = niceMax(maxLeads);

const slot = innerW / Math.max(1, days.length);
const barW = Math.max(2, Math.min(22, slot * 0.6));
const x = (i: number) => pad.left + slot * i + slot / 2;
const yV = (v: number) => pad.top + innerH - (v / vMax) * innerH;
const yL = (v: number) => pad.top + innerH - (v / lMax) * innerH;

const linePoints = days.map((d, i) => `${x(i).toFixed(1)},${yL(d.leads).toFixed(1)}`).join(' ');
const every = Math.max(1, Math.ceil(days.length / 10));
const grid = [0, 0.25, 0.5, 0.75, 1];
const dayLabel = (day: string) => `${day.slice(8, 10)}.${day.slice(5, 7)}.`;
---

<figure>
  <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label={`${labels.visitors} / ${labels.leads}`}>
    {
      grid.map((g) => (
        <>
          <line x1={pad.left} x2={W - pad.right} y1={pad.top + innerH * (1 - g)} y2={pad.top + innerH * (1 - g)} stroke="#e4e4e7" stroke-width="1" />
          <text x={pad.left - 6} y={pad.top + innerH * (1 - g) + 4} text-anchor="end" font-size="11" fill="#71717a">
            {Math.round(vMax * g)}
          </text>
          <text x={W - pad.right + 6} y={pad.top + innerH * (1 - g) + 4} font-size="11" fill="#16a34a">
            {Math.round(lMax * g)}
          </text>
        </>
      ))
    }
    {days.map((d, i) => <rect x={x(i) - barW / 2} y={yV(d.visitors)} width={barW} height={pad.top + innerH - yV(d.visitors)} rx="2" fill="#3b82f6" />)}
    <polyline points={linePoints} fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linejoin="round" />
    {days.map((d, i) => d.leads > 0 && <circle cx={x(i)} cy={yL(d.leads)} r="4" fill="#22c55e" stroke="#fff" stroke-width="1.5" />)}
    {
      days.map(
        (d, i) =>
          i % every === 0 && (
            <text x={x(i)} y={H - 8} text-anchor="middle" font-size="11" fill="#71717a">
              {dayLabel(d.day)}
            </text>
          ),
      )
    }
  </svg>
  <figcaption class="mt-2 flex items-center gap-5 text-xs text-zinc-600">
    <span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 rounded-sm bg-primary"></span>{labels.visitors}</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-0.5 w-4 bg-success"></span>{labels.leads}</span>
  </figcaption>
</figure>
