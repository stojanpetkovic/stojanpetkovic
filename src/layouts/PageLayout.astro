---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses Header + Footer with content page configuration
 */
import BaseLayout from './BaseLayout.astro';
import type { Thing, WithContext } from 'schema-dts';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  showScrollProgress?: boolean;
  eagerReveal?: boolean;
  /**
   * Footer background. Set this to the opposite of the page's last section so
   * the zebra pattern (bg-background ↔ bg-background-secondary) stays intact:
   * - last section `bg-background`           → footer `secondary`
   * - last section `bg-background-secondary` → footer `default`
   */
  footerBackground?: 'default' | 'secondary' | 'invert';
  /** `locale -> URL` map for the LanguageSwitcher, for pages whose path does not exist in every locale. */
  languageAlternates?: Record<string, string>;
  /** Verified locale alternates for this page, forwarded to SEO for hreflang. */
  localeAlternates?: { locale: string; url: string }[];
  /** schema.org type of the page and extra JSON-LD, forwarded to BaseLayout. */
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'ProfilePage';
  extraSchemas?: WithContext<Thing>[];
}

const { title, description, image, imageAlt, noindex, nofollow, showScrollProgress = false, eagerReveal = false, footerBackground = 'default', languageAlternates, localeAlternates, pageType, extraSchemas } = Astro.props;

---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  eagerReveal={eagerReveal}
  localeAlternates={localeAlternates}
  pageType={pageType}
  extraSchemas={extraSchemas}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="solid"
    size="lg"
    showActiveState
    showScrollProgress={showScrollProgress}
    languageAlternates={languageAlternates}
  />

  <main class="min-h-screen pt-[calc(4rem+var(--topbar-h))]">
    <slot />
  </main>

  <Footer slot="footer" layout="columns" background={footerBackground} />
</BaseLayout>
