---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import type { GallerySlide } from '@/lib/gallery';
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import ProjectHero from '@/components/projects/ProjectHero.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { getDefaultOgPath, getProjectOgPath, isShareableImage } from '@/lib/og/svg';
import { t, getLocaleFromPath, localizedPath, getLocales } from '@/i18n';
import {
  getProjectSlug,
  getProjectsBaseUrl,
  getProjectTranslations,
} from '@/lib/projects';

interface Props {
  title: string;
  /** Shorter title for search results and social cards; the heading keeps `title`. */
  seoTitle?: string;
  description: string;
  meta?: string[];
  client?: string;
  role?: string;
  year?: number;
  url?: string;
  repo?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageStyle?: 'frame' | 'blend';
  imageCredit?: string;
  /** Engineering projects (`industry`) read as a plain article; web projects keep the label column. */
  category?: 'industry' | 'web';
  gallery?: GallerySlide[];
  tags?: string[];
  /** Project slug, used to resolve the per-project dynamic OG image. */
  slug?: string;
  related?: CollectionEntry<'projects'>[];
}

const {
  title,
  seoTitle,
  description,
  meta = [],
  client,
  role,
  year,
  url,
  repo,
  image,
  imageAlt,
  imageStyle = 'frame',
  imageCredit,
  category = 'web',
  gallery = [],
  tags = [],
  slug = '',
  related = [],
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);

// Raster only — see the note in BlogLayout: an SVG cover cannot serve as a
// share image, so projects without a screenshot fall back to the card generated
// at build time (see src/pages/og/projects/[slug].png.ts). `slug` is the full
// (locale-prefixed) project id, so strip the locale to match the OG route.
const ogImage =
  image && isShareableImage(image.src)
    ? image.src
    : slug
      ? getProjectOgPath(getProjectSlug(slug, locale))
      : getDefaultOgPath();

const ogImageAlt = ogImage === image?.src ? imageAlt || title : title;

const breadcrumbs = [
  { label: t('common.home', locale), href: localizedPath('/', locale) },
  { label: t('projects.title', locale), href: getProjectsBaseUrl(locale) },
  { label: title },
];

const projectsHref = getProjectsBaseUrl(locale);

// Resolve this project's real per-locale URLs so the hreflang tags and the
// LanguageSwitcher point at the matching translation. Projects share one slug
// across locales, so unlike the blog (which uses canonical uids) matching the
// locale-stripped slug is enough. hreflang lists only verified translations;
// the switcher shows every locale, falling back to a locale's projects index
// when this project has no translation there, so switching never 404s.
const projectTranslations = await getProjectTranslations(getProjectSlug(slug, locale), locale);
const translationByLocale = new Map(projectTranslations.map((tr) => [tr.locale, tr.url]));
const languageAlternates = Object.fromEntries(
  getLocales().map((loc) => [loc, translationByLocale.get(loc) ?? getProjectsBaseUrl(loc)])
);
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  image={ogImage}
  imageAlt={ogImageAlt}
  localeAlternates={projectTranslations}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="solid"
    size="lg"
    showCta={false}
    showScrollProgress
    maxWidth="7xl"
    languageAlternates={languageAlternates}
  />

  <div class="min-h-screen pt-16">
    <ProjectHero
      title={title}
      description={description}
      meta={meta}
      client={client}
      role={role}
      year={year}
      url={url}
      repo={repo}
      image={image}
      imageAlt={imageAlt}
      imageStyle={imageStyle}
      imageCredit={imageCredit}
      gallery={gallery}
      tags={tags}
      breadcrumbs={breadcrumbs}
    />

    <article class="py-10">
      <div class="mx-auto max-w-6xl px-6">
        <div class:list={['project-body prose max-w-none', category === 'industry' && 'project-body--classic']} data-reveal-content>
          <slot />
        </div>

        <footer class="mt-10 border-t border-border pt-6">
          <a href={projectsHref} class="inline-flex items-center gap-2 text-sm font-medium text-foreground-muted underline-offset-4 hover:text-foreground hover:underline">
            <Icon name="arrow-left" size="sm" />
            {t('projects.backToProjects', locale)}
          </a>
        </footer>
      </div>
    </article>

    {related.length > 0 && (
      <section class="border-t border-border bg-background-secondary py-[var(--space-section-md)]" data-reveal>
        <div class="mx-auto max-w-6xl px-6">
          <h2 class="mb-6 font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-foreground-secondary">{t('projects.moreProjects', locale)}</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((project, i) => (
              <ProjectCard project={project} index={i} locale={locale} reveal={false} />
            ))}
          </div>
        </div>
      </section>
    )}
  </div>

  <Footer
    slot="footer"
    layout="columns"
    background="secondary"
    maxWidth="7xl"
  />
</BaseLayout>

<style is:global>
  /* Case-study body, one spacing rhythm throughout:
       1rem between blocks inside a section (paragraph, figure, paragraph),
       1.75rem between sections, 0.75rem from a section's rule to its first line.
     Every child starts with no margin of its own so these three values are the
     only vertical space on the page. */
  .project-body > * {
    margin-block: 0;
  }
  .project-body > * + * {
    margin-top: 1rem;
  }
  .project-body > :not(h2) {
    max-width: 44rem;
  }
  .project-body > h2 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-700);
  }
  .project-body > h2:first-child {
    margin-top: 0;
  }
  .project-body > h2 + * {
    margin-top: 0;
  }
  /* Engineering projects read as an article: ordinary headings above the text,
     and the text runs the full width of the box. */
  .project-body.project-body--classic > h2 {
    float: none;
    clear: both;
    width: auto;
    margin: 2.5rem 0 0.75rem;
    padding: 0;
    border-top: 0;
    font-family: var(--font-display, inherit);
    font-size: 1.5rem;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--color-foreground);
  }
  .project-body.project-body--classic > h2:first-child {
    margin-top: 0;
  }
  .project-body.project-body--classic > :not(h2) {
    max-width: none;
    margin-left: 0;
  }
  .project-body.project-body--classic > h2 + *,
  .project-body.project-body--classic > h2:not(:first-child) + * {
    margin-top: 0;
  }
  /* Data tables: a ruled grid with a heading row, for reading across. The
     label column is set apart in mono so each row names its subject first. */
  .project-body table {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    border: 1px solid var(--color-border-strong);
    border-radius: 0.5rem;
    border-collapse: separate;
    border-spacing: 0;
  }
  .project-body thead {
    border-bottom: 0;
  }
  .project-body th {
    padding: 0.625rem 0.875rem;
    border-bottom: 2px solid var(--color-border-strong);
    background: var(--color-background-secondary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .project-body th + th,
  .project-body td + td {
    border-left: 1px solid var(--color-border);
  }
  .project-body td {
    padding: 0.75rem 0.875rem;
    border-bottom: 1px solid var(--color-border);
  }
  .project-body tr:last-child td {
    border-bottom: 0;
  }
  .project-body tbody tr:nth-child(even) td {
    background: color-mix(in oklab, var(--color-background-secondary) 55%, transparent);
  }
  .project-body td:first-child {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-foreground);
  }
  @media (max-width: 767px) {
    /* A table wider than the phone scrolls inside itself (see .prose table).
       Give each column a readable width so it scrolls as a whole table rather
       than squeezing the last column off the edge. */
    .project-body th,
    .project-body td {
      min-width: 10rem;
    }
    .project-body td:first-child {
      min-width: 7rem;
    }
  }
  @media (min-width: 768px) {
    /* Wide blocks use the full width of the page, not the reading column. */
    .project-body.prose > .project-wide {
      max-width: none;
      margin-left: 0;
      clear: both;
    }
    /* Tables: fixed column widths, the first two columns (theme, source) stay
       narrow and the last two share the rest. */
    .project-body.prose > table {
      display: table;
      table-layout: fixed;
      width: 100%;
      max-width: none;
      margin-left: 0;
      clear: both;
    }
    .project-body th:nth-child(1) { width: 9rem; }
    .project-body th:nth-child(2) { width: 22%; }
    .project-body th:nth-child(3) { width: 30%; }
  }
  @media (min-width: 1024px) {
    /* Label in the left column, copy in the right; the label floats, so the
       copy carries the section gap and the rule offset itself. */
    .project-body > h2 {
      float: left;
      clear: left;
      width: 11rem;
      margin-bottom: 0;
    }
    .project-body > :not(h2) {
      margin-left: 14rem;
      max-width: 42rem;
    }
    .project-body > h2 + * {
      margin-top: 0.75rem;
    }
    .project-body > h2:not(:first-child) + * {
      margin-top: 2.5rem;
    }
  }
</style>
