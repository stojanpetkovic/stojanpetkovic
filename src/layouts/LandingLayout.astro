---
/**
 * LandingLayout
 * Layout wrapper for landing-style pages (marketing, demo, showcase)
 * Uses Header + Footer with landing-specific configuration
 *
 * This layout is part of the "demo" layer - it can be optionally installed
 * via CLI for users who want the full landing page experience.
 */
import BaseLayout from './BaseLayout.astro';
import type { Thing, WithContext } from 'schema-dts';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
  includePersonSchema?: boolean;
  includeProfessionalServiceSchema?: boolean;
  preloadImage?: string;
  /** schema.org type of the page and extra JSON-LD, forwarded to BaseLayout. */
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'ProfilePage';
  extraSchemas?: WithContext<Thing>[];
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  includeOrgSchema = false,
  includePersonSchema = false,
  includeProfessionalServiceSchema = false,
  preloadImage,
  pageType,
  extraSchemas,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  includeOrgSchema={includeOrgSchema}
  includePersonSchema={includePersonSchema}
  includeProfessionalServiceSchema={includeProfessionalServiceSchema}
  preloadImage={preloadImage}
  pageType={pageType}
  extraSchemas={extraSchemas}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="default"
    colorScheme="default"
    size="lg"
    autoHide={false}
    scrollProgressPosition="top"
    invertOnReturn={false}
  />

  <slot />

  <!-- Footer is `background` so it alternates with the `secondary` CTA section above it. -->
  <Footer slot="footer" layout="columns" background="default" />
</BaseLayout>
