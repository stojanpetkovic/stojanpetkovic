{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astro-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "4321"],
      "port": 4321,
      "autoPort": true
    },
    {
      "name": "astro-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["dist/server/entry.mjs"],
      "env": { "HOST": "127.0.0.1", "PORT": "4400" },
      "port": 4400
    }
  ]
}
